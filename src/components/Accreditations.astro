---
import { ACCREDITATIONS } from '../data/site.js';
---
<section class="border-y border-line bg-white py-10">
  <div class="container-x flex flex-col items-center gap-6 lg:flex-row lg:justify-between">
    <p class="text-center font-display text-xl font-bold text-charcoal lg:text-left">Accredited & nationally<br class="hidden lg:block" /> recognized</p>
    <ul class="flex flex-wrap items-center justify-center gap-x-10 gap-y-6">
      {ACCREDITATIONS.map((a) => (
        <li><img src={a.logo} alt={a.name} loading="lazy" class="h-14 w-auto object-contain sm:h-16" /></li>
      ))}
    </ul>
  </div>
</section>
