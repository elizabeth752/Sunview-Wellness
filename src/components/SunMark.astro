---
// Decorative brand motif: the logo's sun rising over a wave (real mark, from the master file),
// plus the concentric "sun rays" arcs used on Sunview's article artwork.
interface Props {
  variant?: 'sun' | 'rays' | 'waves';
  class?: string;
  ripple?: boolean; // rays only: a light pulse travels outward through the rings, like a ripple on water
}
const { variant = 'sun', class: cls = '', ripple = false } = Astro.props;
---
{variant === 'sun' && (
  // The real sun-and-wave mark, cut from the 2560px master logo (not a redrawing), so it matches the lockup.
  <img src="/images/brand/sunview-mark.webp" alt="" width="480" height="226" class={cls} aria-hidden="true" />
)}
{variant === 'rays' && !ripple && (
  <svg class={cls} viewBox="0 0 400 400" fill="none" aria-hidden="true">
    {Array.from({ length: 9 }).map((_, i) => (
      <circle cx="400" cy="0" r={60 + i * 38} stroke="currentColor" stroke-width="1.6" />
    ))}
  </svg>
)}
{variant === 'rays' && ripple && (
  // Same nine rings, but each ring is its own pair of small <svg> boxes (a 1.6 and a 2.6 stroke) pinned to the
  // shared center (top-right corner), so the pulse animates only opacity and transform on HTML-level boxes, which
  // the compositor runs off the main thread (CWV round 2: the old per-<circle> stroke-width animation repainted
  // on every frame). Each box covers just its ring's quarter circle, keeping the layers small.
  <div class:list={[cls, 'sv-ripple']} aria-hidden="true">
    {Array.from({ length: 9 }).map((_, i) => {
      const r = 60 + i * 38;
      const R = r + 2; // room for half the thicker stroke
      const box = `--i:${i};width:${(R / 4).toFixed(3)}%;height:${(R / 4).toFixed(3)}%`;
      return [1.6, 2.6].map((sw) => (
        <svg class:list={['sv-ring', sw > 2 ? 'sv-ring-b' : 'sv-ring-a']} style={box} viewBox={`${400 - R} 0 ${R} ${R}`} fill="none">
          <circle cx="400" cy="0" r={r} stroke="currentColor" stroke-width={sw} />
        </svg>
      ));
    })}
  </div>
)}

<style is:global>
  /* A pulse of light travels outward through still rings, like a ripple crossing water.
     Plays each time the banner comes into view (the script below toggles .is-playing).
     The thin ring fades out while the thick one fades in and back, which reads as the old stroke-width swell. */
  .sv-ripple .sv-ring { position: absolute; top: 0; right: 0; overflow: hidden; transform-origin: 100% 0; } /* the shared center of the rings */
  .sv-ripple .sv-ring-a { opacity: 0.45; }
  .sv-ripple .sv-ring-b { opacity: 0; }
  .sv-ripple.is-playing .sv-ring {
    animation: sv-ripple-a 1.4s ease-out both;
    animation-delay: calc(var(--i) * 160ms + 400ms);
  }
  .sv-ripple.is-playing .sv-ring-b { animation-name: sv-ripple-b; }
  @keyframes sv-ripple-a {
    0% { opacity: 0.45; transform: scale(0.99); }
    35% { opacity: 0; transform: scale(1.005); }
    100% { opacity: 0.45; transform: scale(1); }
  }
  @keyframes sv-ripple-b {
    0% { opacity: 0; transform: scale(0.99); }
    35% { opacity: 1; transform: scale(1.005); }
    100% { opacity: 0; transform: scale(1); }
  }
  @media (prefers-reduced-motion: reduce) {
    .sv-ripple .sv-ring { animation: none !important; }
    .sv-ripple .sv-ring-a { opacity: 1; }
    .sv-ripple .sv-ring-b { opacity: 0; }
  }
</style>
{variant === 'waves' && (
  <svg class={cls} viewBox="0 0 1440 120" preserveAspectRatio="none" fill="none" aria-hidden="true">
    <path d="M0 70c180-50 360-50 540-10s360 40 540 0 270-50 360-30" stroke="currentColor" stroke-width="2" />
    <path d="M0 92c200-36 380-30 560 0s360 30 540-4 250-40 340-26" stroke="currentColor" stroke-width="1.5" opacity=".6" />
    <path d="M0 112c220-24 400-18 580 4s360 18 520-8 240-26 340-16" stroke="currentColor" stroke-width="1" opacity=".35" />
  </svg>
)}

<script>
  // Replay the ripple whenever a banner scrolls back into view: play on enter, reset on leave.
  const ripples = document.querySelectorAll<HTMLElement>('.sv-ripple');
  if (ripples.length && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) e.target.classList.toggle('is-playing', e.isIntersecting);
    }, { threshold: 0.15 });
    ripples.forEach((el) => io.observe(el));
  }
</script>
