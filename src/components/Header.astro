---
// Header: logo left · nav center · "Call Now" button right (client request 2026-09-22).
// Sticky, white, hairline bottom border. Mobile: hamburger → full-screen menu with accordions.
import Icon from './Icon.astro';
import { NAV, SITE } from '../data/site.js';

const path = Astro.url.pathname;
type Item = (typeof NAV)[number];
const isActive = (item: Item) =>
  path === item.href ||
  ('children' in item && (item.children ?? []).some((c) => c.href === path)) ||
  ('mega' in item && (item.mega ?? []).some((col) => col.href === path || col.items.some((i) => i.href === path)));
---
<header class="sticky top-0 z-50 border-b border-line bg-white">
  <div class="container-x flex h-[84px] items-center justify-between gap-4">
    <a href="/" class="shrink-0" aria-label="Sunview Wellness home">
      {/* Horizontal lockup, icon left, as on the official site. Brand book minimum: 140px wide */}
      <img src="/images/brand/sunview-logo-horizontal.webp" alt="Sunview Wellness" width="880" height="174" class="h-auto w-[180px] sm:w-[220px]" />
    </a>

    <nav aria-label="Main" class="hidden xl:block">
      <ul class="flex items-center gap-0.5">
        {NAV.map((item) => (
          <li class="group relative" data-mega-root={'mega' in item ? '' : undefined}>
            {'mega' in item && item.mega ? (
              <button
                type="button"
                class:list={[
                  'inline-flex items-center gap-1 rounded-full px-3 py-2 text-[15px] font-bold hover:bg-mist hover:text-teal',
                  isActive(item) ? 'text-teal' : 'text-charcoal',
                ]}
                aria-expanded="false"
                aria-controls="mega-panel"
                data-mega-toggle
              >
                {item.label}
                <Icon name="chevron" class="h-4 w-4 transition group-data-[open]:rotate-180" />
              </button>
            ) : (
              <a
                href={item.href}
                class:list={[
                  'inline-flex items-center gap-1 rounded-full px-3 py-2 text-[15px] font-bold hover:bg-mist hover:text-teal',
                  isActive(item) ? 'text-teal' : 'text-charcoal',
                ]}
                aria-current={item.href === path ? 'page' : undefined}
              >
                {item.label}
                {'children' in item && <Icon name="chevron" class="h-4 w-4 transition group-hover:rotate-180" />}
              </a>
            )}

            {'children' in item && item.children && (
              <div class="invisible absolute left-0 top-full w-72 translate-y-1 pt-2 opacity-0 transition group-focus-within:visible group-focus-within:translate-y-0 group-focus-within:opacity-100 group-hover:visible group-hover:translate-y-0 group-hover:opacity-100">
                <ul class="rounded-[var(--radius-card)] border border-line bg-white p-2">
                  {item.children.map((c) => (
                    <li>
                      <a href={c.href} class="block rounded-[var(--radius-sm)] px-4 py-2.5 hover:bg-mist">
                        <span class="block font-bold text-charcoal">{c.label}</span>
                        {c.note && <span class="block text-sm text-muted">{c.note}</span>}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )}

            {/* Width capped to the viewport so it never overflows at 1024–1280 */}
            {'mega' in item && item.mega && (
              <div id="mega-panel" class="invisible absolute left-1/2 top-full w-[min(760px,calc(100vw-2rem))] -translate-x-1/2 translate-y-1 pt-2 opacity-0 transition group-data-[open]:visible group-data-[open]:translate-y-0 group-data-[open]:opacity-100">
                <div class="rounded-[var(--radius-card)] border border-line bg-white p-6">
                  <div class="grid grid-cols-3 gap-6">
                    {item.mega.map((col) => (
                      <div>
                        <a href={col.href} class="inline-flex items-center gap-1 border-b-2 border-gold pb-1 font-display text-lg font-bold text-charcoal hover:text-teal">{col.label}</a>
                        {col.note && <p class="mt-3 text-sm text-muted">{col.note}</p>}
                        {col.items.length > 0 && (
                          <ul class="mt-3 space-y-1">
                            {col.items.map((i) => <li><a href={i.href} class="block rounded-[var(--radius-sm)] px-2 py-1.5 text-charcoal hover:bg-mist hover:text-teal">{i.label}</a></li>)}
                          </ul>
                        )}
                        {col.cta && <a href={col.cta.href} class="mt-3 inline-flex items-center gap-1.5 px-2 font-bold text-teal hover:text-teal-light">{col.cta.label} <Icon name="arrow" class="h-4 w-4" /></a>}
                      </div>
                    ))}
                  </div>
                  {item.all && (
                    <a href={item.all.href} class="mt-5 flex items-center gap-1.5 border-t border-line pt-4 font-bold text-teal hover:text-teal-light">{item.all.label} <Icon name="arrow" class="h-4 w-4" /></a>
                  )}
                </div>
              </div>
            )}
          </li>
        ))}
      </ul>
    </nav>

    <div class="flex items-center gap-3">
      {/* Header = logo · menu · one button (client request 2026-09-22). The number is the CTM target
           number; CTM's swap script replaces it with the visitor's tracking number. */}
      <a href={SITE.phoneHref} class="btn-sun hidden !px-5 md:inline-flex"><Icon name="phone" class="h-4 w-4" />Call Now {SITE.phone}</a>
      <button
        type="button"
        class="inline-flex h-11 w-11 items-center justify-center rounded-full text-charcoal hover:bg-mist xl:hidden"
        aria-controls="mobile-nav"
        aria-expanded="false"
        data-nav-toggle
      >
        <span class="sr-only">Open menu</span>
        <Icon name="menu" class="h-6 w-6" />
      </button>
    </div>
  </div>

  {/* Mobile: full-screen menu with accordions */}
  <nav id="mobile-nav" aria-label="Mobile" class="fixed inset-x-0 bottom-0 top-[84px] hidden overflow-y-auto border-t border-line bg-white pb-28 xl:hidden" data-nav-panel>
    <ul class="container-x divide-y divide-line py-2">
      {NAV.map((item) => (
        <li class="py-2">
          {'children' in item && item.children ? (
            <details class="group">
              <summary class="flex cursor-pointer list-none items-center justify-between py-2 text-lg font-bold text-charcoal">
                {item.label}
                <Icon name="chevron" class="h-5 w-5 transition group-open:rotate-180" />
              </summary>
              <ul class="mb-2 space-y-1 pl-3">
                {item.children.map((c) => <li><a href={c.href} class="block rounded-[var(--radius-sm)] px-3 py-2 hover:bg-mist">{c.label}</a></li>)}
              </ul>
            </details>
          ) : 'mega' in item && item.mega ? (
            <details class="group">
              <summary class="flex cursor-pointer list-none items-center justify-between py-2 text-lg font-bold text-charcoal">
                {item.label}
                <Icon name="chevron" class="h-5 w-5 transition group-open:rotate-180" />
              </summary>
              <div class="mb-2 space-y-1 pl-3">
                {item.mega.map((col) => (
                  <details class="group/sub">
                    <summary class="flex cursor-pointer list-none items-center justify-between px-3 py-2 font-bold text-teal">
                      {col.label}
                      <Icon name="chevron" class="h-4 w-4 transition group-open/sub:rotate-180" />
                    </summary>
                    <ul class="pb-2 pl-3">
                      <li><a href={col.href} class="block rounded-[var(--radius-sm)] px-3 py-1.5 font-bold hover:bg-mist">{col.cta ? col.cta.label : `${col.label} overview`}</a></li>
                      {col.items.map((i) => <li><a href={i.href} class="block rounded-[var(--radius-sm)] px-3 py-1.5 hover:bg-mist">{i.label}</a></li>)}
                    </ul>
                  </details>
                ))}
                {item.all && <a href={item.all.href} class="block px-3 py-2 font-bold text-charcoal hover:text-teal">{item.all.label}</a>}
              </div>
            </details>
          ) : (
            <a href={item.href} class="block py-2 text-lg font-bold text-charcoal">{item.label}</a>
          )}
        </li>
      ))}
    </ul>
  </nav>
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const panel = document.querySelector<HTMLElement>('[data-nav-panel]');
  const setOpen = (open: boolean) => {
    btn?.setAttribute('aria-expanded', String(open));
    btn!.querySelector('.sr-only')!.textContent = open ? 'Close menu' : 'Open menu';
    panel?.classList.toggle('hidden', !open);
    document.documentElement.style.overflow = open ? 'hidden' : '';
  };
  btn?.addEventListener('click', () => setOpen(btn.getAttribute('aria-expanded') !== 'true'));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && btn?.getAttribute('aria-expanded') === 'true') setOpen(false);
  });

  // Desktop megamenu, driven only by JS (not :hover/:focus-within, so Esc really closes it): opens on hover
  // and on click; closes on Esc (focus returns to the button), outside click, or focus leaving the menu.
  const megaRoot = document.querySelector<HTMLElement>('[data-mega-root]');
  const megaBtn = megaRoot?.querySelector<HTMLButtonElement>('[data-mega-toggle]');
  if (megaRoot && megaBtn) {
    let pinned = false; // opened by click: stays open until Esc, outside click or a second click
    const show = (open: boolean) => {
      megaRoot.toggleAttribute('data-open', open);
      megaBtn.setAttribute('aria-expanded', String(open));
    };
    megaBtn.addEventListener('click', () => { pinned = !pinned; show(pinned); });
    megaRoot.addEventListener('mouseenter', () => show(true));
    megaRoot.addEventListener('mouseleave', () => { if (!pinned) show(false); });
    megaRoot.addEventListener('focusout', (e) => { if (!megaRoot.contains(e.relatedTarget as Node)) { pinned = false; show(false); } });
    document.addEventListener('click', (e) => { if (!megaRoot.contains(e.target as Node)) { pinned = false; show(false); } });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && megaRoot.hasAttribute('data-open')) { pinned = false; show(false); megaBtn.focus(); }
    });
  }
</script>
