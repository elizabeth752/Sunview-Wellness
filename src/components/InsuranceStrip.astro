---
import Icon from './Icon.astro';
import { INSURANCE } from '../data/site.js';
interface Props { title?: string; lead?: string; showCta?: boolean }
const {
  title = 'Most insurance covers outpatient treatment',
  lead = 'We check your benefits for free before you start, so there are no surprises. We accept most major plans, including Medicaid.',
  showCta = true,
} = Astro.props;
---
<section class="section bg-mist">
  <div class="container-x">
    <div class="grid items-end gap-6 lg:grid-cols-[1.3fr_1fr]">
      <div>
        <span class="eyebrow">Insurance & payment</span>
        <h2 class="mt-3 text-3xl sm:text-4xl">{title}</h2>
        <p class="mt-4 max-w-2xl text-lg text-charcoal">{lead}</p>
      </div>
      {showCta && (
        <div class="flex flex-wrap gap-3 lg:justify-end">
          <a href="/admissions/insurance/" class="btn-teal">Verify my insurance <Icon name="arrow" /></a>
        </div>
      )}
    </div>
    <ul class="mt-10 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-5">
      {INSURANCE.map((c) => (
        <li class="flex h-24 items-center justify-center rounded-2xl border border-line bg-white px-5">
          <img src={c.logo} alt={c.name} loading="lazy" class="max-h-12 w-auto max-w-full object-contain" />
        </li>
      ))}
    </ul>
    <p class="mt-6 text-sm text-charcoal">Plus Medicaid and many other plans. Don’t see yours? <a href="/admissions/" class="font-bold text-teal underline decoration-sun decoration-2 underline-offset-4">Ask us</a>. It’s very likely we can help.</p>
  </div>
</section>
