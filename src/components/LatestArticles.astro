---
// Home §14 "Recovery Resources From the Sunview Team": the first three posts in blog order (articles first, then
// podcasts: client rule 2026-09-24), rendered with the shared PostCard (SOP Blog/Post/Author §0 "Cards").
import PostCard from './PostCard.astro';
import { blogOrder } from '../data/posts.js';
interface Props { title?: string; href?: string }
const { title = 'Recovery Resources From the Sunview Team', href = '/blog/' } = Astro.props;
const latest = blogOrder.slice(0, 3);
---
<section class="section">
  <div class="container-x">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <div class="max-w-5xl">
        <span class="eyebrow">Articles & podcasts</span>
        <h2 class="mt-3 text-3xl sm:text-[2.1875rem]">{title}</h2>
      </div>
      <a href={href} class="btn-ghost">All articles</a>
    </div>
    <ul class="mt-10 grid gap-6 md:grid-cols-3">
      {latest.map((p) => (
        <li><PostCard post={p} as="h3" size="sm" /></li>
      ))}
    </ul>
  </div>
</section>
