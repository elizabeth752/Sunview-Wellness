---
// Minimal banner for /blog/ and /blog/{slug}/ (SOP Blog/Post/Author §1–2), modeled on Breathe's post banner:
// no min-height, tight padding, breadcrumb → H1 (content-column width, ~2 lines) → one compact row (slot).
// Keeps Sunview's hero ground (flat teal + gold sun-ray rings) and fonts. No form, no buttons.
// `narrow`: at ≥1024px the H1 is capped at the article column width (container − 340px sidebar − 30px gap).
import SunMark from '../SunMark.astro';

interface Crumb { name: string; href: string }
interface Props { title: string; crumbs: Crumb[]; narrow?: boolean }
const { title, crumbs, narrow = true } = Astro.props;
---
<section class="sv-hero relative isolate overflow-hidden bg-teal text-white">
  <SunMark variant="rays" ripple class="pointer-events-none absolute -right-16 -top-16 -z-10 h-[420px] w-[420px] text-gold/60 lg:h-[520px] lg:w-[520px]" />
  <div class="container-x pb-10 pt-8 sm:pb-12 sm:pt-10 lg:pb-[60px] lg:pt-[54px]">
    <div class:list={['sv-banner-col', narrow && 'is-narrow']}>
      <nav aria-label="Breadcrumb" class="mb-4 text-[13px] text-white/80">
        <ol class="flex flex-wrap items-center gap-x-2 gap-y-1">
          {[{ name: 'Home', href: '/' }, ...crumbs].map((c, i, all) => (
            <li class="inline-flex min-w-0 items-center gap-2">
              {i < all.length - 1
                ? <><a href={c.href} class="font-bold text-white hover:underline">{c.name}</a><span aria-hidden="true">›</span></>
                : <span aria-current="page" class="line-clamp-1">{c.name}</span>}
            </li>
          ))}
        </ol>
      </nav>
      <h1 class="text-[30px] text-white sm:text-[38px] lg:text-[46px]">{title}</h1>
    </div>
    <slot />
  </div>
</section>

<style>
  @media (min-width: 1024px) {
    .sv-banner-col.is-narrow { max-width: calc(100% - 370px); }
  }
</style>
