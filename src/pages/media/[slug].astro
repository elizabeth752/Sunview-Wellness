---
import Base from '../../layouts/Base.astro';
import CtaBand from '../../components/CtaBand.astro';
import Icon from '../../components/Icon.astro';
import { posts, sortedPosts, formatDate, postImage } from '../../data/posts.js';

export function getStaticPaths() {
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
const url = `https://sunviewwellness.com/media/${post.slug}/`;
const related = sortedPosts.filter((p) => p.slug !== post.slug).slice(0, 3);
const relatedVideo = post.relatedVideo ? posts.find((p) => p.slug === post.relatedVideo) : null;

const schema =
  post.type === 'video'
    ? {
        '@context': 'https://schema.org',
        '@type': 'VideoObject',
        name: post.title,
        description: post.dek,
        thumbnailUrl: postImage(post),
        uploadDate: post.date,
        embedUrl: `https://www.youtube-nocookie.com/embed/${post.youtube}`,
        contentUrl: `https://www.youtube.com/watch?v=${post.youtube}`,
      }
    : {
        '@context': 'https://schema.org',
        '@type': 'Article',
        headline: post.title,
        description: post.dek,
        image: new URL(postImage(post), 'https://sunviewwellness.com').href,
        datePublished: post.date,
        author: { '@type': 'Person', name: post.author.name },
        publisher: { '@id': 'https://sunviewwellness.com/#organization' },
        mainEntityOfPage: url,
      };
---
<Base
  title={`${post.title} | Sunview Wellness`}
  description={post.dek}
  image={postImage(post)}
  type="article"
  breadcrumbs={[{ name: 'Media', href: '/media/' }, { name: post.title, href: `/media/${post.slug}/` }]}
  schema={[schema]}
>
  <article>
    <header class="bg-teal text-white">
      <div class="container-x max-w-4xl py-14 sm:py-20">
        <a href="/media/" class="inline-flex items-center gap-2 text-sm font-bold text-gold hover:text-white"><Icon name="arrow-left" class="h-4 w-4" /> Media & Podcasts</a>
        <p class="mt-6 text-xs font-extrabold uppercase tracking-[0.16em] text-white">
          {post.type === 'video' ? post.show : post.type === 'external' ? 'Article · LinkedIn' : 'Article'} · <time datetime={post.date}>{formatDate(post.date)}</time>
        </p>
        <h1 class="mt-3 text-3xl text-white sm:text-5xl">{post.title}</h1>
        <p class="mt-5 text-lg text-white/80 sm:text-xl">{post.dek}</p>
        <p class="mt-6 text-sm text-white/70">By <strong class="text-white">{post.author.name}</strong>, {post.author.creds}</p>
      </div>
    </header>

    <div class="container-x max-w-4xl py-12 sm:py-16">
      {post.type === 'video' && (
        <div class="yt-facade relative aspect-video overflow-hidden rounded-[1.25rem] bg-teal shadow-[var(--shadow-soft)]" data-yt={post.youtube} data-title={post.title}>
          <img src={postImage(post)} alt="" class="h-full w-full object-cover" />
          <button type="button" class="absolute inset-0 flex items-center justify-center bg-teal/20 transition hover:bg-teal/10" aria-label={`Play video: ${post.title}`}>
            <span class="inline-flex h-20 w-20 items-center justify-center rounded-full bg-sun text-charcoal shadow-xl"><Icon name="play" class="ml-1 h-9 w-9" /></span>
          </button>
        </div>
      )}

      {post.type !== 'video' && post.image && (
        <img src={post.image} alt="" width="1200" height="630" class="w-full rounded-[1.25rem] shadow-[var(--shadow-soft)]" />
      )}

      {post.type === 'article' && <div class="prose-sv mt-10" set:html={post.body} />}

      {post.type !== 'article' && (
        <div class="prose-sv mt-10">
          {post.summary.map((para) => <p>{para}</p>)}
        </div>
      )}

      {post.type === 'external' && (
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={post.externalUrl} target="_blank" rel="noopener" class="btn-teal">{post.externalLabel} <Icon name="external" /></a>
          {relatedVideo && <a href={`/media/${relatedVideo.slug}/`} class="btn-ghost">Watch the full episode</a>}
        </div>
      )}

      {post.type === 'video' && (
        <p class="mt-8"><a href={`https://www.youtube.com/watch?v=${post.youtube}`} target="_blank" rel="noopener" class="inline-flex items-center gap-2 font-extrabold text-teal">Watch on YouTube <Icon name="external" class="h-4 w-4" /></a></p>
      )}

      <aside class="mt-14 flex flex-col gap-5 rounded-[var(--radius-card)] bg-cream p-8 sm:flex-row sm:items-center">
        <span class="inline-flex h-16 w-16 shrink-0 items-center justify-center rounded-full bg-teal font-display text-xl font-bold text-white" aria-hidden="true">FG</span>
        <div>
          <p class="font-display text-xl font-bold text-charcoal">{post.author.name}, {post.author.creds}</p>
          <p class="text-sm text-charcoal">{post.author.role}</p>
        </div>
      </aside>
    </div>
  </article>

  <section class="section bg-mist">
    <div class="container-x">
      <h2 class="text-3xl">More media & podcasts</h2>
      <div class="mt-8 grid gap-6 md:grid-cols-3">
        {related.map((p) => (
          <a href={`/media/${p.slug}/`} class="card group !p-0 overflow-hidden">
            <div class="aspect-[1200/630] overflow-hidden bg-teal"><img src={postImage(p)} alt="" loading="lazy" class="h-full w-full object-cover transition duration-500 group-hover:scale-[1.03]" /></div>
            <div class="p-6">
              <p class="text-xs font-extrabold uppercase tracking-[0.14em] text-teal">{formatDate(p.date)}</p>
              <h3 class="mt-2 text-lg group-hover:text-teal">{p.title}</h3>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <CtaBand />
</Base>

<script>
  // Load the YouTube iframe only when asked (keeps pages fast and avoids third-party cookies until play).
  document.querySelectorAll<HTMLElement>('.yt-facade').forEach((el) => {
    el.querySelector('button')?.addEventListener('click', () => {
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${el.dataset.yt}?autoplay=1&rel=0`;
      iframe.title = el.dataset.title || 'Video';
      iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
      iframe.allowFullscreen = true;
      iframe.className = 'absolute inset-0 h-full w-full';
      el.replaceChildren(iframe);
    });
  });
</script>
