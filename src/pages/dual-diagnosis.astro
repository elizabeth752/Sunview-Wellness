---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import InsuranceStrip from '../components/InsuranceStrip.astro';
import TelemedCard from '../components/TelemedCard.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import { MENTAL_HEALTH } from '../data/site.js';

const signs = [
  { icon: 'link', text: 'You have a diagnosis of co-occurring substance use and mental health disorders and haven’t found a program that addresses both.' },
  { icon: 'refresh', text: 'You feel your mental health is driving your substance use, or the other way around, and the two can’t be separated.' },
  { icon: 'layers', text: 'Traditional rehab didn’t address your underlying mental health needs, and you’ve relapsed or plateaued.' },
  { icon: 'pill', text: 'You need psychiatric support and medication management alongside your addiction treatment.' },
];

const evenIf = [
  'Even if you live in an assisted living facility',
  'Even if you’ve been discharged from a psychiatric hospital',
  'Even if you’re managing more than one condition at once',
  'Even if you’ve tried treatment before and it didn’t work',
];
---
<Base
  title="Dual Diagnosis Treatment West Palm Beach | Sunview Wellness"
  description="Integrated dual diagnosis treatment for co-occurring substance use and mental health disorders in West Palm Beach, FL. PHP, IOP & OP with psychiatric care through Telemed Clinix. Insurance accepted."
  breadcrumbs={[{ name: 'Dual Diagnosis', href: '/dual-diagnosis/' }]}
>
  <PageHero
    eyebrow="Dual diagnosis treatment · West Palm Beach"
    title="You can recover"
    accent="from both."
    lead="When you’re struggling with substance use and your mental health at the same time, you need a team that treats them as one connected picture, not two separate problems."
  />

  <section class="section">
    <div class="container-x">
      <div class="max-w-3xl">
        <span class="eyebrow">Is this you?</span>
        <h2 class="mt-3 text-3xl sm:text-4xl">Does this sound familiar?</h2>
      </div>
      <ul class="mt-10 grid gap-5 md:grid-cols-2">
        {signs.map((s) => (
          <li class="card flex gap-4">
            <span class="inline-flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-mist text-teal"><Icon name={s.icon} class="h-6 w-6" /></span>
            <p class="text-lg text-charcoal">{s.text}</p>
          </li>
        ))}
      </ul>
      <div class="mt-8"><a href="/get-help-now/" class="btn-sun">Yes, please help <Icon name="arrow" /></a></div>
    </div>
  </section>

  <section class="section bg-teal text-white">
    <div class="container-x grid items-center gap-12 lg:grid-cols-2">
      <div>
        <span class="eyebrow eyebrow-light">What “integrated” actually means</span>
        <h2 class="mt-3 text-3xl text-white sm:text-4xl">We treat the cycle, not just the diagnoses</h2>
        <p class="mt-5 text-lg text-white/85">Substance use often starts as a way to cope with emotional pain, and then it deepens the depression, anxiety or trauma it was meant to numb. Over time the two become tightly connected.</p>
        <p class="mt-4 text-lg text-white/85">Integrated treatment means understanding that loop: how your mental health, substance use, relationships, coping habits and life experiences feed each other. Then we help you interrupt it and build healthier ways of responding.</p>
      </div>
      <div class="rounded-[1.5rem] bg-white/10 p-8">
        <p class="font-display text-2xl text-white">“We are not simply treating a diagnosis or trying to eliminate a behavior. We are trying to understand the person behind the symptoms.”</p>
        <p class="mt-5 font-extrabold text-white">Dana Martin, Ph.D., LMFT · Clinical Director</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container-x">
      <div class="grid gap-10 lg:grid-cols-[0.9fr_1.1fr]">
        <div>
          <span class="eyebrow">Co-occurring conditions</span>
          <h2 class="mt-3 text-3xl sm:text-4xl">Mental health conditions we treat alongside addiction</h2>
          <p class="mt-5 text-lg text-charcoal">Anxiety, depression, trauma-related disorders and personality disorders are the co-occurring conditions we see most often.</p>
        </div>
        <ul class="grid gap-4 sm:grid-cols-2">
          {MENTAL_HEALTH.map((m) => (
            <li class="card">
              <h3 class="font-sans text-lg font-extrabold">{m.name}</h3>
              <p class="mt-2 text-sm text-charcoal">{m.blurb}</p>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="section bg-cream">
    <div class="container-x grid gap-12 lg:grid-cols-2">
      <div>
        <span class="eyebrow">Are you a fit?</span>
        <h2 class="mt-3 text-3xl sm:text-4xl">We’ve treated someone just like you</h2>
        <p class="mt-5 text-lg text-charcoal">Over 50 years of combined clinical experience, even when your situation feels unique or complicated.</p>
        <ul class="mt-8 space-y-4">
          {evenIf.map((e) => <li class="flex gap-3 text-lg"><span class="mt-1 inline-flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-teal text-white"><Icon name="check" class="h-4 w-4" /></span>{e}</li>)}
        </ul>
        <a href="/admissions/" class="btn-teal mt-8">Learn your treatment options <Icon name="arrow" /></a>
      </div>
      <div>
        <TelemedCard />
        <div class="mt-6 grid grid-cols-2 gap-3">
          {['PhD Clinical Director', 'LMHCs & LCSWs', 'Certified Addiction Professionals', 'Group Facilitators'].map((t) => (
            <p class="rounded-xl bg-white px-4 py-3 text-sm font-bold text-charcoal">{t}</p>
          ))}
        </div>
      </div>
    </div>
  </section>

  <InsuranceStrip />
  <CtaBand />
</Base>
