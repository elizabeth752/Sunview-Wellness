---
import Base from '../layouts/Base.astro';
import { SITE } from '../data/site.js';
import PageHero from '../components/PageHero.astro';
import FaqList from '../components/FaqList.astro';
import CtaBand from '../components/CtaBand.astro';

// Sources: live /faq/ page + questionnaire responses.
const groups = [
  {
    title: 'Programs & schedules',
    faqs: [
      { q: 'What is Sunview Wellness?', a: 'An outpatient program offering PHP, IOP and OP for substance use disorder and dual diagnosis. Services include individual, family and group counseling, plus referral to our partner psychiatric provider, Telemed Clinix, for evaluation and medication management.' },
      { q: 'What programs does Sunview Wellness offer?', a: 'Three levels of outpatient care: Partial Hospitalization (PHP), Intensive Outpatient (IOP) and Outpatient (OP). All programs include group therapy, with individual and family therapy as clinically recommended.' },
      { q: 'What is the PHP schedule?', a: 'Monday through Friday, 9:00 AM to 1:00 PM: four hours of treatment a day, five days a week.' },
      { q: 'What are the IOP hours?', a: '<strong>Day IOP:</strong> 3 days per week, 9:00 AM – 1:00 PM, on days chosen around your schedule.<br /><strong>Evening IOP:</strong> Monday, Wednesday and Thursday, 6:00 PM – 9:00 PM.' },
      { q: 'What is the average length of stay for IOP?', a: 'Typically 60–90 days, depending on your clinical needs and progress.' },
      { q: 'What happens in a typical day?', a: 'One continuous group from 9 AM to 1 PM with the same facilitator all morning, with breaks. You’ll also have a 45–60 minute individual session with your primary therapist each week, and Telemed Clinix appointments scheduled for you in a private office on site.' },
      { q: 'Do you offer gender-specific groups?', a: 'Yes. On regular gender-specific group days, women and men meet in separate groups following the same program structure.' },
    ],
  },
  {
    title: 'Treatment & medication',
    faqs: [
      { q: 'Do you treat substance use and mental health together?', a: 'Yes. We specialize in dual diagnosis, treating substance use disorders and co-occurring mental health conditions together, as one connected picture.' },
      { q: 'What therapies do you use?', a: 'IFS (Internal Family Systems), CBT, DBT, psychodrama, psychodynamic and inner child work, and trauma-informed care. See <a href="/our-approach/">our approach</a>.' },
      { q: 'Is Sunview abstinence-based?', a: 'Yes. Marijuana, stimulants, opioids and benzodiazepines can’t be used during programming. Appropriately prescribed medications, including anti-craving medications like naltrexone and buprenorphine managed by a qualified provider, are supported.' },
      { q: 'Do you prescribe MAT like Suboxone or Vivitrol?', a: 'Not directly. MAT is managed by a qualified outside provider. If you already have one, we coordinate with them. If you don’t, we can refer you.' },
      { q: 'Can I continue seeing my current doctor or therapist?', a: 'Absolutely. Our team works hand in hand with providers you already see. You’re not saying goodbye to anyone. You’re building a bigger, more supportive team around your care.' },
      { q: 'Is there drug testing?', a: 'Yes. Random drug testing is part of ongoing monitoring and recovery support.' },
    ],
  },
  {
    title: 'Family, insurance & logistics',
    faqs: [
      { q: 'How are families involved?', a: 'With your consent, your therapist contacts a loved one during your first week. After that, involvement might include weekly phone or email updates and family sessions every two weeks or monthly. <a href="/our-approach/#family">Learn more</a>.' },
      { q: 'Do you accept insurance?', a: 'Yes. We accept most major insurance, including Medicaid. Don’t see your plan? Reach out. It’s very likely we can get your treatment covered. <a href="/insurance/">Verify your insurance</a>.' },
      { q: 'Is transportation provided?', a: 'Yes. If you can’t drive yourself, we provide free Uber Health transportation to and from programming.' },
      { q: 'What happens after I finish treatment?', a: 'We follow up with alumni to see how they’re doing and whether they’re still connected to recommended supports. You can also keep seeing your Telemed Clinix psychiatric provider after discharge.' },
      { q: 'Where is Sunview Wellness located?', a: `4802 East Ave, West Palm Beach, FL 33407. Phone: <a href="${SITE.phoneHref}">${SITE.phone}</a>. Email: <a href="mailto:info@sunviewwellness.com">info@sunviewwellness.com</a>.` },
    ],
  },
];
const all = groups.flatMap((g) => g.faqs);
---
<Base
  title="FAQs | Sunview Wellness Outpatient Treatment West Palm Beach"
  description="Answers about outpatient drug rehab at Sunview Wellness in West Palm Beach: PHP & IOP schedules, insurance, medication and MAT, family involvement and free transportation."
  breadcrumbs={[{ name: 'FAQ', href: '/faq/' }]}
  schema={[{ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: all.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a.replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim() } })) }]}
>
  <PageHero eyebrow="Frequently asked questions" title="Got questions?" accent="We have answers." compact />

  <section class="section">
    <div class="container-x max-w-4xl space-y-14">
      {groups.map((g) => (
        <div>
          <h2 class="text-2xl sm:text-3xl">{g.title}</h2>
          <div class="mt-6"><FaqList faqs={g.faqs} /></div>
        </div>
      ))}
    </div>
  </section>

  <CtaBand title="Still have questions?" lead="Our team is here to help you find the right program and navigate your insurance." />
</Base>
