---
// /our-team/: About-Team-Content-Briefs.md §A. Data: src/data/team.js. Sources and open questions:
// docs/content/about-team-sources-team.md. Rotation: Reviews. No reviewed-by byline (brief decision).
// Structure varies on purpose (client, 2026-09-23) and differs from the old /about-us/ card grid:
// leadership as two wide profile features, therapists and group leaders as portrait tiles (therapists in a
// four-up grid on mist, group leaders beside the section intro), admissions on a teal band. Every person uses
// the same TeamCard markup (QA 8 #16); only the variant's layout differs, and "How Our Team Works Together" as
// three pillars around a pull quote.
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Reviews from '../../components/Reviews.astro';
import CtaBand from '../../components/CtaBand.astro';
import Icon from '../../components/Icon.astro';
import TeamCard from '../../components/TeamCard.astro';
import { SITE } from '../../data/site.js';
import { TEAM_GROUPS, PUBLISHED_PEOPLE, peopleInGroup, personHref } from '../../data/team.js';

const path = '/our-team/';
const metaTitle = 'Our Team | Sunview Wellness, West Palm Beach';
const description =
  'Meet our clinical, medical and admissions team in West Palm Beach: licensed therapists, a Ph.D. Clinical Director and 50+ years of combined experience.';
const crumbs = [{ name: 'Our Team', href: path }];
const url = new URL(path, SITE.url).href;

const schema = [
  {
    '@type': 'CollectionPage',
    '@id': `${url}#webpage`,
    url,
    name: metaTitle,
    description,
    isPartOf: { '@id': `${SITE.url}/#website` },
    breadcrumb: { '@id': `${url}#breadcrumb` },
    inLanguage: 'en-US',
    publisher: { '@id': `${SITE.url}/#organization` },
    mainEntity: {
      '@type': 'ItemList',
      itemListElement: PUBLISHED_PEOPLE.map((p, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        url: new URL(personHref(p), SITE.url).href,
        name: p.name,
      })),
    },
  },
];

const leaders = peopleInGroup('leadership');
const therapists = peopleInGroup('therapists');
const facilitators = peopleInGroup('facilitators');
const admissions = peopleInGroup('admissions');
const groupTitle = (id: string) => TEAM_GROUPS.find((g) => g.id === id)!.title;

// "How Our Team Works Together": Q9 (shared foundation, individual niches) and Q15 (supervision).
const pillars = [
  {
    icon: 'layers',
    title: 'A shared clinical foundation',
    text: 'Internal Family Systems (IFS) is woven into group topics, and therapists bring IFS concepts into individual sessions when it’s clinically appropriate. CBT, DBT and trauma-informed care round out a common base, so the experience feels consistent from one clinician to the next.',
    link: { href: '/therapies/', label: 'The therapies we use' },
  },
  {
    icon: 'compass',
    title: 'Room for individual niches',
    text: 'There’s no one-size-fits-all approach, and no single model every clinician has to follow. Sunview honors each clinician’s strengths and specialties and supports them in growing the areas of therapy they care most about, which keeps the team well-rounded and genuinely engaged.',
  },
  {
    icon: 'users',
    title: 'Ongoing clinical supervision by the Clinical Director',
    text: 'The clinical team receives ongoing clinical supervision by the Clinical Director, with a systems lens. Clinicians look beyond the presenting symptom and ask what a behavior is communicating, what function a pattern serves and what might be reinforcing it in a person’s relationships.',
    link: { href: '/our-team/dana-martin/', label: 'Meet Dana Martin, Clinical Director' },
  },
];

const link = 'font-bold text-teal underline decoration-2 underline-offset-4 hover:text-teal-light';
---
<Base title={metaTitle} description={description} breadcrumbs={crumbs} schema={schema}>
  <PageHero
    title="Our Treatment Team in West Palm Beach"
    subheading="Licensed, trauma-informed, and here for the whole way through."
    lead="Sunview’s multidisciplinary team brings more than 50 years of combined clinical experience to outpatient addiction and mental health treatment in West Palm Beach. Our clinical model is led by a Ph.D. Clinical Director, and every clinician is trauma-informed."
    crumbs={crumbs}
    compact
    trust
  />

  {/* Jump links to each group */}
  <nav aria-label="Team sections" class="border-b border-line bg-white">
    <ul class="container-x flex flex-wrap gap-x-6 gap-y-2 py-4 text-sm font-bold">
      {TEAM_GROUPS.map((g) => (
        <li><a href={`#${g.id}`} class="inline-flex items-center gap-2 text-charcoal hover:text-teal">
          <span class="h-[2px] w-4 rounded-full bg-gold" aria-hidden="true"></span>{g.title}
          <span class="font-normal text-muted">({peopleInGroup(g.id).length})</span>
        </a></li>
      ))}
    </ul>
  </nav>

  {/* 1. Leadership: two wide profile features */}
  <section id="leadership" class="section scroll-mt-24" aria-labelledby="leadership-title">
    <div class="container-x">
      <div class="max-w-3xl">
        <h2 id="leadership-title" class="text-3xl sm:text-[2.1875rem]">{groupTitle('leadership')}</h2>
        <p class="mt-4 text-lg">Our CEO sets the standard of care and created the ideas the program is built on. Our Clinical Director shapes the clinical model, recommends each person’s level of care and supervises the clinical team.</p>
      </div>
      <ul class="mt-10 grid gap-8 lg:grid-cols-2">
        {leaders.map((p) => <TeamCard person={p} variant="feature" />)}
      </ul>
    </div>
  </section>

  {/* 2. Therapists: editorial portrait tiles, no card chrome */}
  <section id="therapists" class="section scroll-mt-24 bg-mist" aria-labelledby="therapists-title">
    <div class="container-x">
      <div class="grid gap-6 lg:grid-cols-[1fr_1fr] lg:items-end">
        <h2 id="therapists-title" class="text-3xl sm:text-[2.1875rem]">{groupTitle('therapists')}</h2>
        <p class="text-lg">Every person in the program has a primary therapist for a weekly individual session. Our therapists share a trauma-informed foundation and each bring their own training and focus.</p>
      </div>
      <ul class="mt-12 grid gap-x-6 gap-y-10 sm:grid-cols-2 lg:grid-cols-4">
        {therapists.map((p) => <TeamCard person={p} variant="tile" />)}
      </ul>
    </div>
  </section>

  {/* 3. Group leaders + medical oversight: intro beside a two-up tile grid */}
  <section id="facilitators" class="section scroll-mt-24" aria-labelledby="facilitators-title">
    <div class="container-x grid gap-10 lg:grid-cols-[0.8fr_1.2fr]">
      <div>
        <h2 id="facilitators-title" class="text-3xl sm:text-[2.1875rem]">{groupTitle('facilitators')}</h2>
        <p class="mt-4 text-lg">Day programming runs as one continuous group from 9 AM to 1 PM, led by the same facilitator for the whole morning, so the group can go deeper instead of switching leaders every hour.</p>
        <p class="mt-4">Psychiatric evaluation and medication management are provided through Sunview’s partner, Telemed Clinix, and are coordinated as part of treatment.</p>
        <p class="mt-4 flex flex-wrap gap-x-6 gap-y-2"><a href="/therapies/group-therapy/" class={link}>Group therapy at Sunview</a><a href="/programs/psychiatry-medication-management/" class={link}>Psychiatry and medication management</a></p>
      </div>
      <ul class="grid gap-x-6 gap-y-10 self-start sm:grid-cols-2">
        {facilitators.map((p) => <TeamCard person={p} variant="tile" tone="mist" />)}
      </ul>
    </div>
  </section>

  {/* 4. Admissions and outreach: teal band */}
  <section id="admissions" class="section scroll-mt-24 bg-teal text-white" aria-labelledby="admissions-title">
    <div class="container-x">
      <div class="grid gap-6 lg:grid-cols-[1fr_1fr] lg:items-end">
        <h2 id="admissions-title" class="text-3xl text-white sm:text-[2.1875rem]">{groupTitle('admissions')}</h2>
        <p class="text-lg text-white/90">The people who keep the program running day to day and who work with the professionals and organizations that refer to Sunview.</p>
      </div>
      <ul class="mt-10 grid gap-6 md:grid-cols-2">
        {admissions.map((p) => <TeamCard person={p} variant="band" />)}
      </ul>
      <p class="mt-8 text-white/90">Ready to talk? Call admissions at <a href={SITE.phoneHref} class="font-bold text-white underline decoration-sun decoration-2 underline-offset-4">{SITE.phone}</a> or <a href="/admissions/" class="font-bold text-white underline decoration-sun decoration-2 underline-offset-4">see how admissions works</a>.</p>
    </div>
  </section>

  {/* 5. How our team works together: three pillars + pull quote (Q9, Q15) */}
  <section id="how-we-work" class="section scroll-mt-24 bg-cream" aria-labelledby="how-title">
    <div class="container-x">
      <div class="max-w-3xl">
        <h2 id="how-title" class="text-3xl sm:text-[2.1875rem]">How Our Team Works Together</h2>
        <p class="subheading mt-3">One foundation, many specialties</p>
      </div>
      <ol class="mt-10 grid gap-8 lg:grid-cols-3">
        {pillars.map((x, i) => (
          <li class="border-t-2 border-gold pt-6">
            <div class="flex items-center gap-3">
              <span class="font-sans text-sm font-extrabold text-teal" aria-hidden="true">0{i + 1}</span>
              <Icon name={x.icon} class="h-6 w-6 text-teal" />
            </div>
            <h3 class="mt-3 text-xl">{x.title}</h3>
            <p class="mt-3">{x.text}</p>
            {x.link && <a href={x.link.href} class={`mt-4 inline-block ${link}`}>{x.link.label}</a>}
          </li>
        ))}
      </ol>
      <figure class="mt-14 rounded-[var(--radius-lg)] bg-white p-8 sm:p-12">
        <blockquote class="max-w-4xl font-display text-2xl italic leading-snug text-charcoal sm:text-[1.75rem]">
          “We are not just treating diagnoses or behaviors. We are trying to understand people within the context of their experiences, relationships, and systems and then help them create meaningful changes within those systems.”
        </blockquote>
        <figcaption class="mt-5 font-bold text-teal">Sunview’s Clinical Director</figcaption>
      </figure>
      <p class="mt-8 max-w-3xl text-lg">Want the bigger picture? Read about <a href="/about/our-approach/" class={link}>our clinical approach and how we measure progress</a>.</p>
    </div>
  </section>

  <Reviews />
  <CtaBand />
</Base>
