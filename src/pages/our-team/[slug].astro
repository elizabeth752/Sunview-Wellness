---
// /our-team/{slug}/: About-Team-Content-Briefs.md §B, one template for every published person page.
// Data: src/data/team.js. Sources and open questions: docs/content/about-team-sources-team.md.
// Person template per docs/content/SOP-Blog-Post-Author-Templates.md §3 (one page per person, authors included).
// Banner (Home hero look, no form, no buttons): breadcrumb, H1 = name with credentials, role, photo or initials.
// Body: bio + "Role at Sunview" beside a sticky credentials card at desktop (stacks on mobile).
// Frank also gets "In Vivo Treatment™ and Clinical Architecture™". "Articles by {First}" appears only when
// src/data/posts.js has posts whose author is this person (shared PostCard; ≤3 → grid, >3 → carousel with arrows,
// no URL changes). No links to other staff anywhere on a person page (SOP §3): the team archive is where everyone
// is listed. No rotation sections, no reviewed-by byline.
// Schema: BreadcrumbList (Base) + ProfilePage with a Person mainEntity (bio, photo, LinkedIn, visible credentials).
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import CtaBand from '../../components/CtaBand.astro';
import Icon from '../../components/Icon.astro';
import PostCard from '../../components/PostCard.astro';
import { SITE, initials } from '../../data/site.js';
import { PUBLISHED_PEOPLE, TEAM_GROUPS, personHref } from '../../data/team.js';
import { postsBy } from '../../data/posts.js';

export function getStaticPaths() {
  // Published people only: `publish: false` records stay in team.js but get no page (QA batch 12, item 17).
  return PUBLISHED_PEOPLE.map((person) => ({ params: { slug: person.slug }, props: { person } }));
}

const { person: p } = Astro.props;
const path = personHref(p);
const url = new URL(path, SITE.url).href;
const group = TEAM_GROUPS.find((g) => g.id === p.group)!;
const articles = postsBy(p.slug); // blog order: articles first, then podcasts
const carousel = articles.length > 3;
const crumbs = [{ name: 'Our Team', href: '/our-team/' }, { name: p.name, href: path }];

const nameWithCreds = p.creds ? `${p.name}, ${p.creds}` : p.name;
// <title> ≤60 / description ≤155 (answer 9.1): metaRole and metaDescription in team.js override when too long.
const metaTitle = `${p.name}, ${p.metaRole ?? p.title} | Sunview Wellness`;
const description = p.metaDescription ?? `${nameWithCreds}, ${p.title} at Sunview Wellness in West Palm Beach. ${p.specialty}`;

const personNode: Record<string, unknown> = {
  '@type': 'Person',
  '@id': `${url}#person`,
  name: p.name,
  jobTitle: p.title,
  url,
  worksFor: { '@id': `${SITE.url}/#organization` },
};
// description = the first visible bio paragraph; hasCredential = the credentials and education shown in the card.
if (p.bio?.length) personNode.description = p.bio[0];
if (p.creds) personNode.honorificSuffix = p.creds;
const credentialNodes = [
  ...p.credentials.map((c: { abbr: string; label?: string }) => ({
    '@type': 'EducationalOccupationalCredential',
    name: c.label ? `${c.label} (${c.abbr})` : c.abbr,
  })),
  ...p.education.map((e: string) => ({ '@type': 'EducationalOccupationalCredential', credentialCategory: 'degree', name: e })),
];
if (credentialNodes.length) personNode.hasCredential = credentialNodes;
if (p.photo) personNode.image = new URL(p.photo, SITE.url).href;
if (p.linkedin) personNode.sameAs = [p.linkedin];
if (p.languages) personNode.knowsLanguage = p.languages;

const schema = [
  {
    '@type': 'ProfilePage',
    '@id': `${url}#webpage`,
    url,
    name: metaTitle,
    description,
    isPartOf: { '@id': `${SITE.url}/#website` },
    breadcrumb: { '@id': `${url}#breadcrumb` },
    inLanguage: 'en-US',
    publisher: { '@id': `${SITE.url}/#organization` },
    mainEntity: personNode,
  },
];

// In Vivo loop, verbatim from Frank's article (src/data/posts.js, in-vivo-treatment-…)
const loop = ['Learn', 'Apply', 'Experience', 'Process', 'Adjust', 'Apply again'];
const link = 'font-bold text-teal underline decoration-2 underline-offset-4 hover:text-teal-light';
---
<Base title={metaTitle} description={description} breadcrumbs={crumbs} schema={schema}>
  <PageHero
    title={p.name}
    titleNote={p.creds}
    subheading={p.title}
    crumbs={crumbs}
    actions={false}
    ripple={false}
    banner
  >
    <Fragment slot="aside">
      <div class="mx-auto w-full max-w-[300px] lg:ml-auto lg:mr-0">
        <div class="relative grid aspect-[4/5] place-items-center overflow-hidden rounded-[var(--radius-lg)] bg-mist ring-4 ring-white/15">
          {p.photo
            ? <img src={p.photo} alt={`${p.name}, ${p.title} at Sunview Wellness`} class="absolute inset-0 h-full w-full object-cover" />
            : <span class="grid h-36 w-36 place-items-center rounded-full border-2 border-gold font-display text-6xl font-bold text-teal" role="img" aria-label={`Photo of ${p.name} coming soon`}>{initials(p.name)}</span>}
        </div>
      </div>
    </Fragment>
  </PageHero>

  {/* Bio + role beside the credentials card */}
  <section class="section">
    <div class="container-x grid gap-12 lg:grid-cols-[1fr_340px] lg:gap-x-16 lg:gap-y-14">
      {/* DOM order About → Credentials → Role (brief order, and the mobile stacking order); at desktop the
           credentials card sits in the right column across both rows. */}
      <div class="min-w-0 lg:col-start-1 lg:row-start-1">
        <h2 class="text-3xl sm:text-[2.1875rem]">About {p.first}</h2>
        <div class="prose-sv mt-6 max-w-[68ch] text-lg">
          {p.bio.map((para: string) => <p>{para}</p>)}
        </div>
        {/* No pull-quote here: `highlight` repeats the bio (QA batch 9, item 11); it's only used on /our-team/ leader cards. */}
      </div>

      <aside class="lg:sticky lg:top-28 lg:col-start-2 lg:row-span-2 lg:row-start-1 lg:self-start" aria-labelledby="credentials-title">
        <div class="rounded-[var(--radius-card)] border border-line bg-white p-6 sm:p-7">
          {p.credentials.length > 0 ? (
            <>
              <h2 id="credentials-title" class="text-2xl">Credentials</h2>
              {/* Definition list: the abbreviation (dt) and what it stands for (dd) are separate elements (QA batch 9, item 12). */}
              <dl class="mt-5 space-y-3">
                {p.credentials.map((c: { abbr: string; label?: string }) => (
                  <div class="flex items-start gap-3">
                    <dt class="mt-0.5 inline-flex min-w-[3.25rem] shrink-0 justify-center rounded-full bg-mist px-2 py-0.5 font-sans text-xs font-extrabold text-teal">{c.abbr}</dt>
                    {c.label && <dd class="text-[15px] leading-snug"><span class="sr-only">: </span>{c.label}</dd>}
                  </div>
                ))}
              </dl>
            </>
          ) : (
            <h2 id="credentials-title" class="text-2xl">{p.experience ? 'Experience' : 'At Sunview'}</h2>
          )}
          {p.experience && (
            <ul class="mt-4 space-y-2 text-[15px]">
              {p.experience.map((e: string) => <li class="flex items-start gap-2"><Icon name="check" class="mt-1 h-4 w-4 shrink-0 text-teal" />{e}</li>)}
            </ul>
          )}
          {p.education.length > 0 && (
            <>
              <h3 class="mt-6 border-t border-line pt-5 text-base">Education</h3>
              <ul class="mt-3 space-y-2 text-[15px]">
                {p.education.map((e: string) => <li class="flex items-start gap-2"><Icon name="award" class="mt-0.5 h-4 w-4 shrink-0 text-gold" />{e}</li>)}
              </ul>
            </>
          )}
          {p.languages && (
            <p class="mt-5 border-t border-line pt-5 text-[15px]"><span class="font-bold">Languages:</span> {p.languages.join(' and ')}</p>
          )}
          <dl class="mt-6 space-y-1 border-t border-line pt-5 text-[15px]">
            <div><dt class="inline font-bold">Role: </dt><dd class="inline">{p.title}</dd></div>
            <div><dt class="inline font-bold">Team: </dt><dd class="inline">{group.title}</dd></div>
          </dl>
          {p.linkedin && (
            <a href={p.linkedin} class="mt-5 inline-flex items-center gap-2 font-bold text-teal hover:text-teal-light" rel="noopener" target="_blank">
              <Icon name="linkedin" class="h-5 w-5" />{p.first} on LinkedIn
            </a>
          )}
        </div>

      </aside>

      <div class="min-w-0 lg:col-start-1 lg:row-start-2">
        <h2 class="text-3xl sm:text-[2.1875rem]">Role at Sunview</h2>
        <div class="prose-sv mt-6 max-w-[68ch]">
          {p.role.map((para: string) => <p set:html={para} />)}
        </div>
      </div>
    </div>
  </section>

  {p.inVivo && (
    <section class="section bg-mist" aria-labelledby="invivo-title">
      <div class="container-x grid gap-12 lg:grid-cols-[1.1fr_0.9fr] lg:items-center">
        <div>
          <h2 id="invivo-title" class="text-3xl sm:text-[2.1875rem]">In Vivo Treatment™ and Clinical Architecture™</h2>
          <div class="prose-sv mt-6">
            <p>Frank is the creator of In Vivo Treatment™ and Clinical Architecture™. Both grew out of one question that has shaped his career: can I stay sober while actually living my life?</p>
            <p><em>In vivo</em> essentially means “within the living environment.” The idea is that recovery skills shouldn’t just exist on paper. At some point, people have to practice them where their life actually happens, then bring what happened back into treatment and work through it.</p>
            <p>Clinical Architecture™ is how Frank builds treatment environments that foster accountability, connection, structure and sustainable recovery. Two of its ideas, Clinical Excellence and Recovery Culture, shape how Sunview thinks about the treatment environment: clinical excellence gives treatment its substance, and recovery culture gives that treatment somewhere to live.</p>
            <p>Read more about <a href="/about/our-approach/">Sunview’s clinical approach and outcomes</a>, or Frank’s own article, <a href="/blog/in-vivo-treatment-at-sunview-wellness-recovery-has-to-work-in-the-real-world/">In Vivo Treatment™ at Sunview Wellness: Recovery Has to Work in the Real World</a>.</p>
          </div>
        </div>
        <figure class="rounded-[var(--radius-lg)] bg-white p-7 sm:p-9">
          <ol class="grid grid-cols-2 gap-3 sm:grid-cols-3">
            {loop.map((step, i) => (
              <li class:list={['flex items-center gap-3 rounded-[var(--radius-card)] p-4', i === loop.length - 1 ? 'bg-sun/30' : 'bg-mist']}>
                <span class="font-sans text-sm font-extrabold text-teal" aria-hidden="true">{i + 1}</span>
                <span class="font-bold text-charcoal">{step}</span>
              </li>
            ))}
          </ol>
          <figcaption class="mt-5 text-[15px]">The In Vivo feedback loop: people live life, apply their skills, bring the experience back to the program and process what happened.</figcaption>
        </figure>
      </div>
    </section>
  )}

  {articles.length > 0 && (
    <section class:list={['section', p.inVivo ? 'bg-white' : 'bg-mist']} aria-labelledby="articles-title">
      <div class="container-x">
        <div class="flex flex-wrap items-end justify-between gap-4">
          <h2 id="articles-title" class="text-3xl sm:text-[2.1875rem]">Articles by {p.first}</h2>
          <div class="flex items-center gap-4">
            <a href="/blog/" class={link}>All articles and podcasts</a>
            {carousel && (
              <div class="flex gap-2">
                <button type="button" class="sv-arrow" aria-label={`Previous articles by ${p.first}`} aria-controls="articles-track" data-dir="-1"><Icon name="chevron-left" class="h-5 w-5" /></button>
                <button type="button" class="sv-arrow" aria-label={`Next articles by ${p.first}`} aria-controls="articles-track" data-dir="1"><Icon name="chevron-right" class="h-5 w-5" /></button>
              </div>
            )}
          </div>
        </div>
        {carousel ? (
          <ul id="articles-track" class="sv-track mt-8" aria-label={`Articles by ${p.name}`} data-track>
            {articles.map((post) => <li><PostCard post={post} as="h3" /></li>)}
          </ul>
        ) : (
          <ul class="mt-8 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
            {articles.map((post) => <li><PostCard post={post} as="h3" /></li>)}
          </ul>
        )}
      </div>
    </section>
  )}

  <CtaBand title="Start With a Conversation" headingLevel="h2" />
</Base>

<style>
  /* Articles carousel: scroll-snap track, 1 card visible on phones, 2 on tablets, 3 at desktop */
  .sv-track {
    display: grid; grid-auto-flow: column; grid-auto-columns: 86%; gap: 1.5rem;
    overflow-x: auto; scroll-snap-type: x mandatory; scroll-behavior: smooth; overscroll-behavior-x: contain;
    padding-bottom: 0.75rem; scrollbar-width: thin;
  }
  .sv-track > li { scroll-snap-align: start; }
  @media (min-width: 768px) { .sv-track { grid-auto-columns: calc((100% - 1.5rem) / 2); } }
  @media (min-width: 1024px) { .sv-track { grid-auto-columns: calc((100% - 3rem) / 3); } }
  .sv-arrow {
    display: inline-grid; place-items: center; width: 44px; height: 44px; border-radius: 9999px;
    border: 2px solid var(--color-teal); color: var(--color-teal); background: #fff; transition: background-color .2s, color .2s, opacity .2s;
  }
  .sv-arrow:hover:not(:disabled) { background: var(--color-teal); color: #fff; }
  .sv-arrow:disabled { opacity: .35; cursor: default; }
</style>

<script>
  // Articles carousel arrows: scroll by one card; no URL changes. Arrows disable at the ends.
  document.querySelectorAll<HTMLElement>('[data-track]').forEach((track) => {
    const section = track.closest('section')!;
    const arrows = [...section.querySelectorAll<HTMLButtonElement>('.sv-arrow')];
    const step = () => {
      const card = track.querySelector<HTMLElement>('li');
      return card ? card.getBoundingClientRect().width + parseFloat(getComputedStyle(track).columnGap || '24') : track.clientWidth;
    };
    const update = () => {
      const max = track.scrollWidth - track.clientWidth - 2;
      arrows.forEach((a) => (a.disabled = a.dataset.dir === '-1' ? track.scrollLeft <= 2 : track.scrollLeft >= max));
    };
    arrows.forEach((a) => a.addEventListener('click', () => track.scrollBy({ left: step() * Number(a.dataset.dir), behavior: 'smooth' })));
    track.addEventListener('scroll', () => requestAnimationFrame(update), { passive: true });
    addEventListener('resize', update);
    update();
  });
</script>
