---
// /programs/ hub: Programs-Content-Briefs.md §5. Sources in docs/content/programs-sources.md.
// The only program page with the Reviews rotation section. No length-of-stay figures (brief rule).
import ProgramPage from '../../layouts/ProgramPage.astro';
import ProgramSchedule from '../../components/ProgramSchedule.astro';
import Icon from '../../components/Icon.astro';

// Comparison: one card per level, rows aligned across cards with subgrid so it reads as a table.
const rows = ['Schedule', 'Hours per week', 'Best for', 'Typical entry point', 'What continues'];
const levels = [
  {
    code: 'PHP',
    name: 'Partial Hospitalization Program',
    href: '/programs/php/',
    head: 'bg-teal text-white',
    cells: [
      'Monday to Friday, 9 AM to 1 PM',
      'About 20',
      'The most structure and clinical support we offer, while living at home',
      'After detox or residential treatment, or from home when weekly therapy isn’t enough',
      'Weekly individual session · psychiatric care · free door-to-door transportation',
    ],
  },
  {
    code: 'IOP',
    name: 'Intensive Outpatient Program',
    href: '/programs/iop/',
    head: 'bg-teal-light text-white',
    cells: [
      'Day: any 3 weekdays, 9 AM to 1 PM · Evening: Mon, Wed, Thu, 6 to 9 PM',
      '9 to 12',
      'Working adults, parents and students who need real clinical depth',
      'Stepping down from PHP or residential care, or a first step when your pre-screening supports it',
      'Weekly individual session · psychiatric care · free door-to-door transportation',
    ],
  },
  {
    code: 'OP',
    name: 'Outpatient Program',
    href: '/programs/outpatient/',
    head: 'bg-cream text-charcoal',
    cells: [
      'One weekday of your choice, 9 AM to 1 PM',
      'About 4',
      'Ongoing support while life gets back to normal, and longer-term maintenance',
      'Stepping down from PHP or IOP, or a first step when your pre-screening supports it',
      'Individual sessions as recommended · psychiatric care · free door-to-door transportation',
    ],
  },
];

const steps = [
  { title: 'A short pre-screening', text: 'Why you’re reaching out, your history, your living situation and how you’re feeling now.' },
  { title: 'Clinical Director review', text: 'Our Clinical Director personally reviews every pre-screening: symptoms, length of sobriety, treatment history and home environment.' },
  { title: 'A recommendation that fits', text: 'ASAM criteria plus clinical judgment, aimed at the level that sets you up to succeed.' },
];

const notOffered = [
  { label: 'Detox', text: 'If stopping could cause dangerous withdrawal, you’ll need medically supervised detox first. We’ll help you find it.' },
  { label: 'Residential treatment', text: 'If you need 24-hour care, we’ll refer you to residential treatment and plan Sunview as your next step.' },
  { label: 'Housing', text: 'All three levels are outpatient. You live at home and come to us for treatment.' },
  { label: 'Methadone maintenance', text: 'Methadone needs a different level of medical support than we provide. We’ll help you find a program that offers it.' },
];

const faqs = [
  { q: 'What is the difference between PHP and IOP?', a: 'Intensity. PHP meets every weekday morning, about 20 hours a week. IOP meets three days a week, day or evening, 9 to 12 hours. Both include group therapy, a weekly individual session and psychiatric care.' },
  { q: 'Do I have to start with PHP?', a: 'No. Many people start in PHP after detox or residential treatment, but you can start in IOP or OP if your pre-screening supports it.' },
  { q: 'How do you decide my level of care?', a: 'Our Clinical Director reviews your pre-screening and recommends a level using ASAM criteria and clinical judgment: your symptoms, length of sobriety, treatment history and home environment. <a href="/admissions/">Start your pre-screening</a>.' },
  { q: 'Can I switch levels during treatment?', a: 'Yes. Most people step down as they progress, and you can step back up if you need more support, with the same team the whole time.' },
  { q: 'Is any of this residential?', a: 'No. PHP, IOP and OP are all outpatient. You sleep at home every night. If you need residential care first, we’ll help you get there.' },
];
---
<ProgramPage
  path="/programs/"
  metaTitle="Outpatient Levels of Care in West Palm Beach | Sunview"
  description="Compare PHP, IOP and OP at Sunview Wellness in West Palm Beach. Hours, who each level is for, and how the Clinical Director recommends the right one."
  crumb="Programs"
  h1="Outpatient Treatment Programs in West Palm Beach"
  subheading="Three levels of care, one team the whole way through."
  lead="PHP, IOP and outpatient treatment for adults with substance use and co-occurring mental health conditions. Compare them, and let our Clinical Director help you find the right fit."
  therapy={{
    name: 'Outpatient addiction and mental health treatment: PHP, IOP and OP',
    description: 'Three outpatient levels of care in West Palm Beach (Partial Hospitalization, Intensive Outpatient and Outpatient) for substance use and co-occurring mental health conditions, with integrated psychiatric care.',
  }}
  faqTitle="Frequently Asked Questions About Levels of Care"
  faqs={faqs}
  reviews
>
  {/* 1. Comparison */}
  <section class="section">
    <div class="container-x">
      <div class="max-w-5xl">
        <span class="eyebrow">Side by side</span>
        <h2 class="mt-3 text-3xl sm:text-[2.1875rem]">PHP, IOP and OP Compared</h2>
        <p class="subheading mt-3">Same team, same clinical model, different amounts of time</p>
      </div>
      <div class="mt-10 grid gap-6 lg:grid-cols-3">
        {levels.map((l) => (
          <article class="card grid grid-rows-subgrid overflow-hidden !p-0 [grid-row:span_7]">
            <div class:list={['px-6 pb-5 pt-6', l.head]}>
              <p class="font-display text-4xl font-extrabold leading-none">{l.code}</p>
              <h3 class:list={['mt-2 font-sans text-lg font-extrabold', l.code === 'OP' ? 'text-charcoal' : 'text-white']}>{l.name}</h3>
            </div>
            {l.cells.map((c, i) => (
              <div class="border-t border-line px-6 py-4">
                <p class="text-xs font-extrabold uppercase tracking-[0.08em] text-muted">{rows[i]}</p>
                <p class:list={['mt-1', i < 2 && 'font-bold text-charcoal']}>{c}</p>
              </div>
            ))}
            <div class="border-t border-line px-6 pb-6 pt-4">
              <a href={l.href} class="inline-flex items-center gap-2 font-extrabold text-teal hover:text-teal-light">{l.name} <Icon name="arrow" class="h-4 w-4" /></a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  {/* 2. How the level is chosen */}
  <section class="section bg-mist">
    <div class="container-x">
      <div class="max-w-5xl">
        <span class="eyebrow">Placement</span>
        <h2 class="mt-3 text-3xl sm:text-[2.1875rem]">How the Clinical Director Recommends Your Level of Care</h2>
        <p class="subheading mt-3">“An inappropriate level of care is a disservice.”</p>
        <p class="mt-5 text-lg">You don’t have to figure out which program you need before you call. That’s our job.</p>
      </div>
      <ol class="mt-10 grid gap-6 lg:grid-cols-3">
        {steps.map((s, i) => (
          <li class="card flex gap-5">
            <span class="font-sans text-3xl font-extrabold text-teal" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <h3 class="text-xl">{s.title}</h3>
              <p class="mt-1">{s.text}</p>
            </div>
          </li>
        ))}
      </ol>
      <a href="/admissions/" class="btn-teal mt-8">Start your pre-screening <Icon name="arrow" /></a>
    </div>
  </section>

  {/* 3 + 4. Moving between levels, psychiatry */}
  <section class="section">
    <div class="container-x grid gap-6 lg:grid-cols-2">
      <article class="rounded-[var(--radius-lg)] border border-line p-8">
        <Icon name="layers" class="h-8 w-8 text-teal" />
        <h2 class="mt-4 text-2xl sm:text-[1.75rem]">Moving Between Levels as You Progress</h2>
        <p class="mt-4">Treatment moves from stabilization, to insight, to integration. Most people step down from PHP to IOP to OP, with the same therapists.</p>
        <p class="mt-3">Recovery isn’t linear. If a hard season hits, you can step back up for more support, then step down again, without starting over. See our approach to <a href="/what-we-treat/substance-use/" class="font-bold text-teal underline decoration-2 underline-offset-4">substance use treatment</a> and <a href="/what-we-treat/dual-diagnosis/" class="font-bold text-teal underline decoration-2 underline-offset-4">dual diagnosis treatment</a>.</p>
      </article>
      <article class="rounded-[var(--radius-lg)] bg-teal p-8 text-white">
        <Icon name="pill" class="h-8 w-8 text-sun" />
        <h2 class="mt-4 text-2xl text-white sm:text-[1.75rem]">Psychiatric Care at Every Level</h2>
        <p class="mt-4 text-white/90">Psychiatric evaluation and medication management through Telemed Clinix are part of PHP, IOP and OP, scheduled for you in a private office on site. You can keep the same provider after you finish.</p>
        <a href="/programs/psychiatry-medication-management/" class="btn-ghost-light mt-6 !h-auto min-h-[45px] py-3 text-center !whitespace-normal sm:!whitespace-nowrap">Psychiatric care and medication management</a>
      </article>
    </div>
  </section>

  {/* 5. What we don't offer */}
  <section class="section bg-mist">
    <div class="container-x grid gap-10 lg:grid-cols-[0.8fr_1.2fr]">
      <div>
        <span class="eyebrow">Honest about scope</span>
        <h2 class="mt-3 text-3xl sm:text-[2.1875rem]">What Sunview Does Not Offer, and Where We Send You</h2>
        <p class="subheading mt-3">If you need something else first, we’ll help you find it.</p>
        <p class="mt-5 text-lg">Outpatient care works when you’re medically and psychiatrically steady enough to take part.</p>
        <p class="mt-4"><a href="/therapies/group-therapy/" class="font-bold text-teal underline decoration-2 underline-offset-4">How group therapy works at Sunview</a></p>
      </div>
      <dl class="divide-y divide-line self-start rounded-[var(--radius-card)] border border-line bg-white">
        {notOffered.map((n) => (
          <div class="grid gap-1 p-6 sm:grid-cols-[0.8fr_1.2fr] sm:gap-6">
            <dt class="font-extrabold">{n.label}</dt>
            <dd>{n.text}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  {/* 6. Weekly schedule, all levels */}
  <ProgramSchedule
    class="section"
    title="Weekly Program Schedule in West Palm Beach"
    subtitle="Every level at a glance"
  />
</ProgramPage>
