---
// /programs/php/: Programs-Content-Briefs.md §2. Sources in docs/content/programs-sources.md.
// No length-of-stay figures anywhere (brief rule; pending Elizabeth).
import ProgramPage from '../../layouts/ProgramPage.astro';
import ProgramSchedule from '../../components/ProgramSchedule.astro';
import ScopeNote from '../../components/ScopeNote.astro';
import Icon from '../../components/Icon.astro';

const includes = [
  'Treatment Monday to Friday, 9 AM to 1 PM, about 20 hours a week',
  'One continuous group with the same facilitator all morning',
  'A weekly individual session with your primary therapist, 45 to 60 minutes',
  'Psychiatric care through Telemed Clinix, scheduled for you',
  'Free door-to-door transportation to and from our center if you can’t drive yourself',
];

const day = [
  { time: 'Morning', title: 'Arrive and settle in', text: 'If you use our free door-to-door transportation, your ride is already booked.' },
  { time: '9 AM to 1 PM', title: 'The group block', text: 'One facilitator leads the whole morning, with breaks, so the conversation goes deeper instead of restarting every hour.' },
  { time: 'During the week', title: 'Your individual session', text: 'Once a week you meet one-on-one with your primary therapist for 45 to 60 minutes. If something urgent comes up, you can ask for a check-in sooner.' },
  { time: 'When scheduled', title: 'Psychiatric appointment', text: 'Telemed Clinix visits happen virtually from a private office at Sunview. We book them for you, and prescriptions go to the pharmacy you choose.' },
  { time: 'Ongoing', title: 'Random drug testing', text: 'Part of how we support your recovery and keep the group safe.' },
  { time: 'Afternoon', title: 'Home, and real life', text: 'Afternoons and evenings are yours. What happens at home becomes material for the next morning’s group.' },
];

const phases = [
  { title: 'Stabilization', text: 'In PHP, the first job is steadiness: a daily structure, psychiatric care in place, and room to breathe after detox or residential treatment.' },
  { title: 'Insight', text: 'As trust builds, the work shifts from “how do I get through this?” to “why do I respond this way?” The patterns underneath start to show.' },
  { title: 'Integration', text: 'You practice new responses at home and at work, then step down to IOP and OP with the same team as your life takes more of the week back.' },
];

const faqs = [
  { q: 'Is PHP an inpatient program?', a: 'PHP is our most structured outpatient level. You attend treatment in the morning and sleep at home every night. If you need housing or overnight care first, we’ll help you find it.' },
  { q: 'What are the PHP hours?', a: 'Monday to Friday, 9 AM to 1 PM, about 20 hours of treatment a week. Your individual session and any psychiatric appointments are scheduled around that block.' },
  { q: 'Can I work during PHP?', a: 'Some people do. PHP ends at 1 PM, so afternoons and evenings are free for work, school or family. If mornings are impossible, our <a href="/programs/iop/">Intensive Outpatient Program</a> has an evening option.' },
  { q: 'What happens after PHP?', a: 'Most people step down to IOP, then to our <a href="/programs/outpatient/">Outpatient Program</a>, with the same therapists the whole way. Your team reviews your treatment plan with you every month and adjusts the level as you progress.' },
  { q: 'Is PHP covered by insurance?', a: 'Most plans cover partial hospitalization, including Medicaid plans. We check your benefits for free before you start. <a href="/admissions/insurance/">See accepted insurance and payment options</a>.' },
];
---
<ProgramPage
  path="/programs/php/"
  metaTitle="Partial Hospitalization (PHP) in West Palm Beach | Sunview"
  description="PHP in West Palm Beach: outpatient care Monday to Friday, 9 AM to 1 PM. Sleep at home, free door-to-door transportation. Joint Commission accredited."
  crumb="Partial Hospitalization Program"
  h1="Partial Hospitalization Program in West Palm Beach"
  subheading="Full mornings of treatment, five days a week, and your own bed every night."
  lead="Our Partial Hospitalization Program (PHP) is the most structured level of outpatient care at Sunview, for adults with substance use and co-occurring mental health conditions who need daily support while living at home."
  therapy={{
    name: 'Partial Hospitalization Program (PHP)',
    description: 'Structured outpatient treatment Monday to Friday, 9 AM to 1 PM, for substance use and co-occurring mental health conditions: continuous group therapy, weekly individual therapy and integrated psychiatric care.',
  }}
  faqTitle="Frequently Asked Questions About PHP"
  faqs={faqs}
  linksClass=""
>
  {/* 1. What PHP is */}
  <section class="section">
    <div class="container-x grid gap-12 lg:grid-cols-[1.1fr_0.9fr]">
      <div>
        <span class="eyebrow">The program</span>
        <h2 class="mt-3 text-3xl sm:text-[2.1875rem]">What the Partial Hospitalization Program Is</h2>
        <p class="subheading mt-3">Daily structure without leaving home</p>
        <div class="prose-sv mt-6">
          <p>PHP gives you treatment every weekday morning, from 9 AM to 1 PM, about 20 hours a week. It’s the most structure we offer, and you still go home every night.</p>
          <p>Your mornings are one continuous group led by the same facilitator from start to finish, with breaks. On top of that, you meet with your primary therapist one-on-one every week, and you see a psychiatric provider through our Telemed Clinix partnership when medication is part of your care. If you can’t drive yourself, free door-to-door transportation to and from our center is available.</p>
          <p>PHP treats substance use and mental health together. Read more about our <a href="/what-we-treat/substance-use/">substance use treatment</a> and how we approach <a href="/what-we-treat/dual-diagnosis/">dual diagnosis treatment</a>.</p>
        </div>
      </div>
      <aside class="card self-start !p-7">
        <h3 class="text-xl">What PHP includes</h3>
        <ul class="mt-4 space-y-3">
          {includes.map((i) => <li class="flex items-start gap-3"><Icon name="check-circle" class="mt-0.5 h-5 w-5 shrink-0 text-teal" />{i}</li>)}
        </ul>
        <a href="/programs/psychiatry-medication-management/" class="mt-6 inline-flex items-center gap-2 font-bold text-teal underline decoration-2 underline-offset-4 hover:text-teal-light">Psychiatric care and medication management <Icon name="arrow" class="h-4 w-4" /></a>
      </aside>
    </div>
  </section>

  {/* 2. Who PHP is for */}
  <section class="section bg-mist">
    <div class="container-x grid gap-12 lg:grid-cols-2">
      <div>
        <span class="eyebrow">Who it’s for</span>
        <h2 class="mt-3 text-3xl sm:text-[2.1875rem]">Who PHP Is Designed For</h2>
        <p class="subheading mt-3">The most support we offer, while you live at home</p>
        <p class="mt-5 text-lg">Most people who come to Sunview are stepping down from detox or residential treatment, and PHP is often where they start. That step matters: staying engaged in care after a higher level is linked to stronger long-term recovery. Others come straight from home because they, or someone who loves them, can see that weekly therapy isn’t enough anymore.</p>
        <p class="mt-4 text-lg">PHP fits when you need the most structure and clinical support we offer but have a safe, stable place to live.</p>
        <p class="mt-4 text-lg">Before you start, see <a href="/admissions/what-to-expect/" class="font-bold text-teal underline decoration-2 underline-offset-4 hover:text-teal-light">what your first week looks like</a>.</p>
      </div>
      <div class="self-center">
        <div class="card !p-7">
          <h3 class="text-xl">Treatment in the morning, home in the afternoon</h3>
          <p class="mt-3">PHP is outpatient: no housing, no overnight care. You come in the morning and go home after 1 PM. If you need 24-hour care right now, we’ll help you find it first.</p>
        </div>
      </div>
    </div>
  </section>

  {/* 3. A day in PHP */}
  <section class="section">
    <div class="container-x">
      <div class="max-w-5xl">
        <span class="eyebrow">Inside the program</span>
        <h2 class="mt-3 text-3xl sm:text-[2.1875rem]">A Day in PHP at Sunview</h2>
        <p class="subheading mt-3">What your weekday actually looks like</p>
      </div>
      <ol class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {day.map((d) => (
          <li class="card">
            <span class="font-sans text-[13px] font-extrabold uppercase tracking-[0.08em] text-teal">{d.time}</span>
            <h3 class="mt-2 text-xl">{d.title}</h3>
            <p class="mt-2">{d.text}</p>
          </li>
        ))}
      </ol>
      <p class="mt-8 text-lg"><a href="/therapies/group-therapy/" class="font-bold text-teal underline decoration-2 underline-offset-4 hover:text-teal-light">Group therapy at Sunview</a>.</p>
    </div>
  </section>

  {/* 4. The continuum */}
  <section class="section bg-mist">
    <div class="container-x grid gap-12 lg:grid-cols-[0.9fr_1.1fr]">
      <div>
        <span class="eyebrow">The continuum</span>
        <h2 class="mt-3 text-3xl sm:text-[2.1875rem]">Stabilization, Insight, Integration: How PHP Fits the Continuum</h2>
        <p class="subheading mt-3">PHP → IOP → OP, with the same team</p>
        <p class="mt-5 text-lg">In higher levels of care, you’re protected from everyday stressors. In PHP, you’re back in them: home, family, work.</p>
        <p class="mt-4 text-lg">As you progress, you step down to our <a href="/programs/iop/" class="font-bold text-teal underline decoration-2 underline-offset-4">Intensive Outpatient Program</a> and then the <a href="/programs/outpatient/" class="font-bold text-teal underline decoration-2 underline-offset-4">Outpatient Program</a>, without changing therapists.</p>
      </div>
      <ol class="grid gap-4">
        {phases.map((p, i) => (
          <li class="card flex gap-5">
            <span class="font-sans text-3xl font-extrabold text-teal" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <h3 class="text-2xl">{p.title}</h3>
              <p class="mt-1">{p.text}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  {/* 5. Higher level first */}
  <section class="section">
    <div class="container-x grid gap-12 lg:grid-cols-2">
      <div>
        <span class="eyebrow">Safety first</span>
        <h2 class="mt-3 text-3xl sm:text-[2.1875rem]">Who Needs a Higher Level of Care First</h2>
        <p class="subheading mt-3">If you need something else first, we’ll help you find it.</p>
        <p class="mt-5 text-lg">Our Clinical Director reviews every pre-screening and recommends a level of care using ASAM criteria and clinical judgment. Sometimes the right answer is to start somewhere else, and then come to us.</p>
        <a href="/admissions/" class="btn-teal mt-8">Talk to admissions <Icon name="arrow" /></a>
      </div>
      <div class="self-start">
      <dl class="divide-y divide-line rounded-[var(--radius-card)] border border-line">
        <div class="grid gap-1 p-6 sm:grid-cols-[0.8fr_1.2fr] sm:gap-6">
          <dt class="font-extrabold">Long-term opioid or benzodiazepine use</dt>
          <dd>Stopping can cause dangerous withdrawal. Medically supervised detox, and often residential treatment, comes first. PHP is a strong next step after that.</dd>
        </div>
        <div class="grid gap-1 p-6 sm:grid-cols-[0.8fr_1.2fr] sm:gap-6">
          <dt class="font-extrabold">Methadone maintenance</dt>
          <dd>Methadone needs a different level of medical support than we provide. We’ll help you find a program that offers it.</dd>
        </div>
      </dl>
      <ScopeNote class="mt-5" />
      </div>
    </div>
  </section>

  {/* 6. Weekly schedule */}
  <ProgramSchedule
    highlight={['PHP']}
    title="PHP Schedule in West Palm Beach"
    subtitle="Every weekday morning, 9 AM to 1 PM"
  />
</ProgramPage>
