---
// /what-we-treat/substance-use/alcohol/: What-We-Treat-Content-Briefs.md §E. Sources in
// docs/content/what-we-treat-sources-substance.md. Rotation: Reviews only. Reviewed by Frank.
import ServicePage from '../../../layouts/ServicePage.astro';
import NextSteps from '../../../components/NextSteps.astro';
import Icon from '../../../components/Icon.astro';
import { WWT, CATEGORIES, SUBSTANCE_PAGES, siblings } from '../../../data/treat.js';
import { conditionAbout } from '../../../lib/programSchema.js';

const path = '/what-we-treat/substance-use/alcohol/';

const signs = [
  'You drink more, or for longer, than you meant to',
  'You’ve tried to cut back, and it hasn’t held',
  'Drinking is causing problems at work, at home or in your relationships, and you keep going anyway',
  'You need more to feel the same effect',
  'You feel shaky, anxious or sick when you stop, and a drink makes it go away',
  'Plans and people you care about keep getting pushed aside',
  'The people closest to you are worried',
];

const how = [
  { icon: 'users', title: 'One group, one facilitator', text: 'The same clinician leads your group for the whole session, with breaks, so the conversation goes deeper instead of restarting every hour.' },
  { icon: 'message', title: 'A weekly session that’s yours', text: 'You meet one-on-one with your primary therapist every week for 45 to 60 minutes, and sooner if something comes up.' },
  { icon: 'layers', title: 'The why behind the drinking', text: 'Psychodynamic work, inner child work and Internal Family Systems help you understand what the drinking has been doing for you, so you can meet that need another way.' },
  { icon: 'pill', title: 'Naltrexone is welcome', text: 'Anti-craving medication like naltrexone is supported when a qualified outside provider prescribes and manages it. We coordinate with them.' },
  { icon: 'refresh', title: 'Real life comes back to group', text: 'The Friday night, the hard conversation at home: you bring what actually happened back into the room, and we practice a different response.' },
  { icon: 'heart', title: 'Family, when you’re ready', text: 'With your consent, your therapist contacts a loved one in your first week. After that, involvement moves at your pace.' },
];

// QA batch 3, item 1: facts reused from the program pages and /admissions/what-to-expect/ (no new claims).
const weeks = [
  { label: 'Week one', title: 'Getting started', text: 'Intake, your first groups and your first one-on-one session. With your consent, your therapist contacts a loved one, and we schedule your Telemed Clinix psychiatric appointment for you.' },
  { label: 'Most days', title: 'A morning or an evening', text: 'In PHP, one continuous group from 9 AM to 1 PM with the same facilitator. If you work days, evening IOP meets Monday, Wednesday and Thursday from 6 to 9 PM. Once a week, 45 to 60 minutes with your primary therapist.' },
  { label: 'Over time', title: 'Stepping down', text: 'As your days fill back up, you move from PHP to IOP to OP with the same team. If an outside provider prescribes naltrexone, it continues alongside.' },
];

const faqs = [
  { q: 'Do I need detox before alcohol treatment?', a: 'It depends on how much and how long you’ve been drinking. Alcohol withdrawal can be dangerous, so after heavy drinking over a long time, medically supervised detox may need to come first. We look at this with you during pre-screening and help you find detox if you need it.' },
  { q: 'Can I keep working during alcohol treatment?', a: 'Yes. Evening IOP meets Monday, Wednesday and Thursday from 6 to 9 PM, and day programs end at 1 PM. <a href="/programs/iop/">See the Intensive Outpatient Program</a>.' },
  { q: 'Can I take naltrexone while I’m in the program?', a: 'Yes. Naltrexone and other anti-craving medications are welcome when a qualified outside provider prescribes and manages them. If you don’t have one, we can refer you.' },
  { q: 'What if I also struggle with anxiety or depression?', a: 'That’s common, and we treat both together, with psychiatric care through Telemed Clinix included. <a href="/what-we-treat/dual-diagnosis/">Learn about dual diagnosis treatment</a>.' },
  { q: 'Does insurance cover alcohol rehab?', a: 'Most plans cover outpatient alcohol treatment, including Medicaid plans. We verify your benefits for free before you start. <a href="/admissions/insurance/">See accepted insurance and payment options</a>.' },
];
---
<ServicePage
  path={path}
  metaTitle="Alcohol Rehab & Addiction Treatment in West Palm Beach"
  description="Alcohol rehab in West Palm Beach: outpatient PHP, IOP and OP for adults ready to stop drinking without leaving home. Free door-to-door transportation."
  crumbs={[WWT, { name: CATEGORIES.substance.name, href: CATEGORIES.substance.href }, { name: 'Alcohol Addiction Treatment', href: path }]}
  h1="Alcohol Addiction Treatment in West Palm Beach"
  subheading="Stop drinking without putting your whole life on hold."
  lead="Outpatient treatment for adults whose drinking has stopped feeling manageable. Day and evening options, a team that looks at what’s underneath the drinking, and free door-to-door transportation if you can’t drive."
  faqTitle="Frequently Asked Questions About Alcohol Addiction Treatment"
  faqs={faqs}
  reviews
  about={conditionAbout('Alcohol use disorder')}
>
  {/* Signs */}
  <section class="section">
    <div class="container-x grid items-start gap-12 lg:grid-cols-2">
      <div>
        <span class="eyebrow">Recognizing it</span>
        <h2 class="mt-3 text-3xl sm:text-[2.1875rem]">Signs Alcohol Use Has Become a Problem</h2>
        <p class="subheading mt-3">When drinking takes more than it gives</p>
        <p class="mt-5 text-lg">There’s no single line that makes drinking a problem. For most people it’s a slow realization that alcohol has started running things. You don’t need to be sure it’s “bad enough” to call. A conversation with admissions is where most people start.</p>
      </div>
      <div class="card !p-7">
        <h3 class="text-xl">Some common signs</h3>
        <ul class="mt-4 space-y-3">
          {signs.map((s) => <li class="flex items-start gap-3"><Icon name="check" class="mt-1 h-4 w-4 shrink-0 text-teal" />{s}</li>)}
        </ul>
        <p class="mt-5 border-t border-line pt-4 font-bold text-teal">Recognizing a few of these is reason enough to call. You don’t need to be sure.</p>
      </div>
    </div>
  </section>

  {/* How we treat */}
  <section class="section bg-mist">
    <div class="container-x">
      <div class="max-w-5xl">
        <span class="eyebrow">Treatment</span>
        <h2 class="mt-3 text-3xl sm:text-[2.1875rem]">How Sunview Treats Alcohol Addiction</h2>
        <p class="subheading mt-3">Sobriety removes the drink. Recovery looks at the life around it.</p>
        <p class="mt-5 text-lg">Alcohol is the substance we see most often at Sunview. Treatment happens in PHP, IOP or OP, and if you work days, <a href="/programs/iop/#evening-iop" class="font-bold text-teal underline decoration-2 underline-offset-4">evening IOP</a> meets Monday, Wednesday and Thursday from 6 to 9 PM.</p>
      </div>
      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {how.map((h) => (
          <div class="card">
            <Icon name={h.icon} class="h-7 w-7 text-teal" />
            <h3 class="mt-4 text-xl">{h.title}</h3>
            <p class="mt-2">{h.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* Co-occurring + detox */}
  <section class="section">
    <div class="container-x grid gap-6 lg:grid-cols-2">
      <article class="rounded-[var(--radius-lg)] border border-line p-7 sm:p-9">
        <Icon name="brain" class="h-8 w-8 text-teal" />
        <h2 class="mt-4 text-2xl sm:text-[1.75rem]">Alcohol and Co-Occurring Mental Health</h2>
        <p class="mt-4">Drinking often travels with anxiety, depression or trauma. It can start as a way to cope, and over time make those same symptoms worse. That cycle is why we treat both together, with one team and psychiatric care through Telemed Clinix included.</p>
        <p class="mt-3">Read more about <a href="/what-we-treat/mental-health/depression/" class="font-bold text-teal underline decoration-2 underline-offset-4">depression and addiction treatment</a>, <a href="/what-we-treat/mental-health/anxiety/" class="font-bold text-teal underline decoration-2 underline-offset-4">anxiety and addiction treatment</a> and <a href="/what-we-treat/mental-health/" class="font-bold text-teal underline decoration-2 underline-offset-4">co-occurring mental health treatment</a>.</p>
      </article>
      <article class="rounded-[var(--radius-lg)] bg-cream p-7 sm:p-9">
        <Icon name="shield" class="h-8 w-8 text-teal" />
        <h2 class="mt-4 text-2xl sm:text-[1.75rem]">When Detox Comes First</h2>
        <p class="mt-4">Alcohol withdrawal can be dangerous. If you’ve been drinking heavily for a long time, stopping suddenly can carry real medical risk, and medically supervised detox may need to come first.</p>
        <p class="mt-3">We’ll look at this with you during pre-screening, help you find a detox program if you need one, and plan Sunview as your next step. Many people come to us right after detox.</p>
      </article>
    </div>
  </section>

  {/* Week to week: 3-step horizontal strip (QA batch 3, item 1) */}
  <section class="section bg-cream">
    <div class="container-x">
      <div class="max-w-3xl">
        <span class="eyebrow">Week to week</span>
        <h2 class="mt-3 text-3xl sm:text-[2.1875rem]">What Treatment Looks Like Week to Week</h2>
        <p class="subheading mt-3">From your first morning to stepping down</p>
        <p class="mt-5 text-lg">Many people start with us right after detox. Here’s how the weeks usually go.</p>
      </div>
      <ol class="relative mt-12 grid gap-8 lg:grid-cols-3 lg:gap-8">
        <span class="absolute left-0 right-0 top-[22px] hidden h-[2px] bg-gold lg:block" aria-hidden="true"></span>
        {weeks.map((w, i) => (
          <li class="relative flex gap-4 lg:block">
            <span class="relative z-10 inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-teal font-sans font-extrabold text-white ring-4 ring-cream">{i + 1}</span>
            <div class="lg:mt-5">
              <p class="text-xs font-extrabold uppercase tracking-[0.08em] text-teal">{w.label}</p>
              <h3 class="mt-1 text-xl">{w.title}</h3>
              <p class="mt-2">{w.text}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <NextSteps
    title="Which Level of Care Fits"
    subtitle="Where most people start with alcohol"
    level={`<p>Many people start in the <a href="/programs/php/">Partial Hospitalization Program</a> right after detox, for the most structure. If you work days, the <a href="/programs/iop/">Intensive Outpatient Program</a> has an evening option. When your days fill back up, the <a href="/programs/outpatient/">Outpatient Program</a> keeps one morning a week in place. Our Clinical Director recommends the level that fits you.</p>`}
    related={[
      { label: CATEGORIES.substance.label, href: CATEGORIES.substance.href },
      ...siblings(SUBSTANCE_PAGES, ['cocaine', 'benzodiazepines']),
      { label: CATEGORIES.dual.label, href: CATEGORIES.dual.href },
    ]}
  />
</ServicePage>
