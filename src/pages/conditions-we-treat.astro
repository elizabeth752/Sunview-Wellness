---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import InsuranceStrip from '../components/InsuranceStrip.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import { SUBSTANCES, MENTAL_HEALTH } from '../data/site.js';
---
<Base
  title="Conditions We Treat | Substance Abuse Treatment West Palm Beach | Sunview Wellness"
  description="Sunview Wellness treats alcohol, cocaine, opioid, benzodiazepine and other substance use disorders, plus co-occurring depression, anxiety, PTSD and more, in West Palm Beach, FL. PHP, IOP & OP."
  breadcrumbs={[{ name: 'Conditions We Treat', href: '/conditions-we-treat/' }]}
>
  <PageHero
    eyebrow="What we treat"
    title="Conditions We Treat"
    lead="Specialized outpatient care for substance use disorders and the mental health conditions that so often come with them."
    compact
  />

  <section class="section">
    <div class="container-x">
      <div class="grid gap-10 lg:grid-cols-[0.9fr_1.1fr]">
        <div>
          <span class="eyebrow">Primary focus</span>
          <h2 class="mt-3 text-3xl sm:text-4xl">Substance use disorders</h2>
          <p class="mt-5 text-lg text-charcoal">Our primary specialty. Each substance use disorder is treated with evidence-based, individualized care. The substances we see most often are alcohol and crack cocaine.</p>
          <a href="/substance-use-disorder/" class="btn-teal mt-8">Substance use treatment <Icon name="arrow" /></a>
        </div>
        <ul class="grid gap-4 sm:grid-cols-2">
          {SUBSTANCES.map((s) => (
            <li class="card">
              <h3 class="font-sans text-lg font-extrabold">{s.name}</h3>
              <p class="mt-2 text-sm text-charcoal">{s.blurb}</p>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="section bg-mist">
    <div class="container-x">
      <div class="grid gap-10 lg:grid-cols-[0.9fr_1.1fr]">
        <div>
          <span class="eyebrow">Dual diagnosis</span>
          <h2 class="mt-3 text-3xl sm:text-4xl">Co-occurring mental health conditions</h2>
          <p class="mt-5 text-lg text-charcoal">Mental health and substance use are often deeply intertwined. We treat the following conditions when they occur alongside a substance use disorder, and we treat them together rather than one at a time.</p>
          <a href="/dual-diagnosis/" class="btn-teal mt-8">Learn about dual diagnosis <Icon name="arrow" /></a>
        </div>
        <ul class="grid gap-4 sm:grid-cols-2">
          {MENTAL_HEALTH.map((s) => (
            <li class="card">
              <h3 class="font-sans text-lg font-extrabold">{s.name}</h3>
              <p class="mt-2 text-sm text-charcoal">{s.blurb}</p>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container-x grid gap-8 lg:grid-cols-2">
      <div class="rounded-[var(--radius-card)] bg-cream p-8 sm:p-10">
        <p class="text-xs font-extrabold uppercase tracking-[0.16em] text-teal">Secondary concerns</p>
        <h3 class="mt-2 text-2xl">Gambling, sex & love addiction, eating concerns</h3>
        <p class="mt-4 text-charcoal">Many clients have a history of behaviors like these. When they aren’t the primary issue, we treat them as part of the whole person, since they’re often connected to the same underlying emotional and relational patterns.</p>
        <p class="mt-3 text-charcoal">If one of them becomes the primary concern, or starts to interfere with your ability to participate, we’ll help you connect with a specialized program.</p>
      </div>
      <div class="rounded-[var(--radius-card)] border border-line p-8 sm:p-10">
        <p class="text-xs font-extrabold uppercase tracking-[0.16em] text-teal">Knowing our scope</p>
        <h3 class="mt-2 text-2xl">Treating the whole person doesn’t mean treating everything</h3>
        <p class="mt-4 text-charcoal">If psychiatric symptoms worsen significantly, someone becomes unable to participate safely, or there’s an imminent risk of harm, we refer to a more appropriate level of care for stabilization. Our job is to understand the full clinical picture and be honest about what you need.</p>
        <p class="mt-3 font-bold text-charcoal">In crisis right now? Call or text 988, or dial 911.</p>
      </div>
    </div>
  </section>

  <InsuranceStrip />
  <CtaBand />
</Base>
