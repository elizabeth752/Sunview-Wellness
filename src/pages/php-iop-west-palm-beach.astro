---
import Base from '../layouts/Base.astro';
import { SITE } from '../data/site.js';
import PageHero from '../components/PageHero.astro';
import InsuranceStrip from '../components/InsuranceStrip.astro';
import CtaBand from '../components/CtaBand.astro';
import FaqList from '../components/FaqList.astro';
import LeadForm from '../components/LeadForm.astro';
import Icon from '../components/Icon.astro';

const rows = [
  ['Schedule', 'Monday–Friday, 9 AM – 1 PM', 'Day: 3 days/week, 9 AM – 1 PM\nEvening: Mon/Wed/Thu, 6 – 9 PM'],
  ['Treatment hours', '20 hours per week', '9–12 hours per week'],
  ['Individual therapy', 'Weekly, 45–60 minutes', 'Weekly, 45–60 minutes'],
  ['Psychiatric care', 'Telemed Clinix, on site in a private office', 'Telemed Clinix, on site in a private office'],
  ['Best for', 'Stepping down from detox or residential, higher clinical needs, maximum structure while living at home', 'Working adults, parents and students; step-down from PHP; people who need flexibility'],
  ['Typical next step', 'IOP', 'OP, then alumni follow-up'],
];

const faqs = [
  { q: 'What’s the difference between PHP and IOP?', a: 'Both treat substance use disorders and dual diagnosis with the same clinical team and approach. The difference is intensity: PHP meets five mornings a week (20 hours), while IOP meets three days or evenings a week (9–12 hours).' },
  { q: 'Who decides whether I start in PHP or IOP?', a: 'Our Clinical Director reviews your pre-screening (history, current symptoms, time in recovery, treatment history and home environment) and recommends a level of care using ASAM criteria and clinical judgment. Starting at the wrong level can be a disservice, so we take this seriously.' },
  { q: 'What is the average length of stay for IOP?', a: 'Typically 60–90 days, depending on your clinical needs and progress. We don’t rush the deeper work: as you stabilize, therapy can move from “How do I get through this?” to “Why do I respond this way in the first place?”' },
  { q: 'How do I get to programming?', a: 'If you can’t drive yourself, we arrange Uber Health transportation to and from programming at no cost to you.' },
];
---
<Base
  title="PHP & IOP West Palm Beach | Partial Hospitalization & Intensive Outpatient"
  description={`Partial Hospitalization (PHP) and Intensive Outpatient (IOP) addiction treatment in West Palm Beach, FL. Day and evening IOP, free transportation, most insurance accepted. Call ${SITE.phone}.`}
  breadcrumbs={[{ name: 'PHP & IOP West Palm Beach', href: '/php-iop-west-palm-beach/' }]}
  schema={[{ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) }]}
>
  <PageHero
    eyebrow="PHP & IOP Programs · West Palm Beach, Florida"
    title="PHP & IOP Programs"
    accent="West Palm Beach"
    lead="Partial Hospitalization (PHP) and Intensive Outpatient (IOP) addiction treatment in West Palm Beach. Live at home, get free transportation, and use most insurance plans."
    stats={[
      { value: 'PHP', label: '20 hours / week' },
      { value: 'IOP', label: 'Day & evening options' },
      { value: 'Free', label: 'Transportation' },
      { value: 'Most', label: 'Insurance accepted' },
    ]}
  />

  <section class="section">
    <div class="container-x">
      <div class="max-w-3xl">
        <span class="eyebrow">PHP vs IOP</span>
        <h2 class="mt-3 text-3xl sm:text-4xl">What’s the difference between PHP and IOP?</h2>
        <p class="mt-5 text-lg text-charcoal">Both programs treat substance use disorders and dual diagnosis with the same team and the same depth. The main difference is intensity and hours per week.</p>
      </div>
      <div class="mt-10 overflow-x-auto rounded-[var(--radius-card)] border border-line">
        <table class="w-full min-w-[640px] text-left">
          <thead>
            <tr class="bg-teal text-white">
              <th scope="col" class="w-1/5 px-6 py-5 text-sm font-extrabold uppercase tracking-wider text-white/70"><span class="sr-only">Feature</span></th>
              <th scope="col" class="px-6 py-5"><span class="font-display text-3xl font-extrabold text-white">PHP</span><span class="block text-sm font-bold text-white/80">Partial Hospitalization</span></th>
              <th scope="col" class="px-6 py-5"><span class="font-display text-3xl font-extrabold text-white">IOP</span><span class="block text-sm font-bold text-white/80">Intensive Outpatient</span></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-line">
            {rows.map(([k, a, b], i) => (
              <tr class={i % 2 ? 'bg-mist/60' : 'bg-white'}>
                <th scope="row" class="px-6 py-4 align-top font-extrabold text-charcoal">{k}</th>
                <td class="whitespace-pre-line px-6 py-4 align-top text-charcoal">{a}</td>
                <td class="whitespace-pre-line px-6 py-4 align-top text-charcoal">{b}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section id="php" class="section scroll-mt-28 bg-cream">
    <div class="container-x grid gap-12 lg:grid-cols-2">
      <div>
        <span class="eyebrow">Partial Hospitalization Program</span>
        <h2 class="mt-3 text-3xl sm:text-4xl">PHP: the most support you can get while living at home</h2>
        <p class="mt-5 text-lg text-charcoal">Monday through Friday, 9 AM to 1 PM. PHP is often the first step after detox or residential treatment. It gives you daily structure and clinical support while you start handling life outside a facility again.</p>
        <ul class="mt-6 space-y-3">
          <li class="flex gap-3"><Icon name="check-circle" class="mt-1 h-5 w-5 shrink-0 text-teal" />One continuous group with the same facilitator all morning</li>
          <li class="flex gap-3"><Icon name="check-circle" class="mt-1 h-5 w-5 shrink-0 text-teal" />Weekly individual therapy with your primary therapist</li>
          <li class="flex gap-3"><Icon name="check-circle" class="mt-1 h-5 w-5 shrink-0 text-teal" />Psychiatric evaluation and medication management through Telemed Clinix</li>
          <li class="flex gap-3"><Icon name="check-circle" class="mt-1 h-5 w-5 shrink-0 text-teal" />Free Uber Health transportation if you can’t drive yourself</li>
        </ul>
      </div>
      <div id="iop" class="scroll-mt-28">
        <span class="eyebrow">Intensive Outpatient Program</span>
        <h2 class="mt-3 text-3xl sm:text-4xl">IOP: real clinical depth around your schedule</h2>
        <p class="mt-5 text-lg text-charcoal">Day IOP meets three mornings a week (9 AM – 1 PM) on days chosen around your life. Evening IOP meets Monday, Wednesday and Thursday from 6 to 9 PM, so you can keep working or caring for family.</p>
        <ul class="mt-6 space-y-3">
          <li class="flex gap-3"><Icon name="check-circle" class="mt-1 h-5 w-5 shrink-0 text-teal" />Average length of stay of 60–90 days</li>
          <li class="flex gap-3"><Icon name="check-circle" class="mt-1 h-5 w-5 shrink-0 text-teal" />The same clinical model as PHP: IFS, CBT, DBT, psychodrama and trauma-informed care</li>
          <li class="flex gap-3"><Icon name="check-circle" class="mt-1 h-5 w-5 shrink-0 text-teal" />Regular gender-specific group days</li>
          <li class="flex gap-3"><Icon name="check-circle" class="mt-1 h-5 w-5 shrink-0 text-teal" />Family involvement when clinically appropriate</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container-x grid items-start gap-12 lg:grid-cols-[1.1fr_0.9fr]">
      <div>
        <span class="eyebrow">Gender-specific days</span>
        <h2 class="mt-3 text-3xl sm:text-4xl">Regular gender-specific group days</h2>
        <p class="mt-5 text-lg text-charcoal">The day follows the same structure, but women meet together in one room and men in another. Clients tell us it’s easier to share some experiences with people who relate. Clients asked for more of them, and the program expanded them.</p>
        <div class="mt-10">
          <span class="eyebrow">PHP & IOP FAQ</span>
          <div class="mt-5"><FaqList faqs={faqs} /></div>
        </div>
      </div>
      <div class="lg:sticky lg:top-32">
        <LeadForm formId="php-iop" heading="Find out which level fits" sub="Tell us a little about you. We’ll verify insurance and call you back." />
      </div>
    </div>
  </section>

  <InsuranceStrip title="Does insurance cover PHP & IOP?" lead="Yes. Most insurance plans cover PHP and IOP treatment. We verify your benefits before you start, so there are no surprises." />
  <CtaBand title="Start PHP or IOP in West Palm Beach" lead="Call us or fill out the form and we’ll handle everything from insurance verification to scheduling. Free transportation is included." />
</Base>
