---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import ProgramCards from '../components/ProgramCards.astro';
import InsuranceStrip from '../components/InsuranceStrip.astro';
import Accreditations from '../components/Accreditations.astro';
import CtaBand from '../components/CtaBand.astro';
import FaqList from '../components/FaqList.astro';
import TelemedCard from '../components/TelemedCard.astro';
import Icon from '../components/Icon.astro';
import { SUBSTANCES, SITE } from '../data/site.js';

const reasons = [
  { icon: 'award', title: 'Joint Commission accredited', text: 'The gold standard in behavioral healthcare accreditation.' },
  { icon: 'users', title: 'PhD-led clinical team', text: 'Over 50 years of combined experience in addiction and mental health treatment.' },
  { icon: 'car', title: 'Free transportation', text: 'Uber Health rides to and from programming at no cost, if you can’t drive yourself.' },
  { icon: 'pill', title: 'Psychiatric support', text: 'Medication management through our Telemed Clinix partnership.' },
  { icon: 'home', title: 'Live at home', text: 'Keep your family, job and daily life while you’re in treatment.' },
  { icon: 'shield', title: 'Insurance accepted', text: 'Most major plans accepted, including Medicaid. Free benefits check.' },
];

const faqs = [
  { q: 'Is outpatient drug rehab as effective as inpatient?', a: 'For people who are medically stable and have a safe place to live, outpatient treatment lets you practice recovery in the same environment where you’ll need it. That’s the idea behind our In Vivo Treatment™ model. If you need detox or a higher level of care first, we’ll tell you honestly and help you get there.' },
  { q: 'Do I need to detox before starting?', a: 'Sometimes. If you’ve been using alcohol, benzodiazepines or opioids heavily or for a long time, stopping can carry real medical risk. Our pre-screening looks at the substance, amount, frequency and duration of use. If medically supervised detox is needed, we refer you to it first and welcome you when you’re stable.' },
  { q: 'How soon can I start?', a: `Once your pre-screening is complete and your benefits are verified, enrollment can often happen within days. Call <a href="${SITE.phoneHref}">${SITE.phone}</a> and we’ll walk you through it.` },
  { q: 'Is Sunview an abstinence-based program?', a: 'Yes. Marijuana, stimulants, opioids and benzodiazepines can’t be used while you’re in programming. Abstinence-based doesn’t mean medication-free, though: appropriately prescribed medications, including anti-craving medications like naltrexone or buprenorphine managed by a qualified provider, are supported.' },
];
---
<Base
  title="Drug Rehab West Palm Beach | Outpatient PHP, IOP & OP | Sunview Wellness"
  description={`Outpatient drug and alcohol rehab in West Palm Beach, FL. PHP, IOP & OP programs for adults 18+, with free transportation and most insurance accepted, including Medicaid. Call ${SITE.phone}.`}
  breadcrumbs={[{ name: 'Drug Rehab West Palm Beach', href: '/drug-rehab-west-palm-beach/' }]}
  schema={[{ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a.replace(/<[^>]+>/g, '') } })) }]}
>
  <PageHero
    eyebrow="Drug & Alcohol Rehab · West Palm Beach, Florida"
    title="Drug Rehab in"
    accent="West Palm Beach"
    lead="Outpatient drug and alcohol rehab for adults 18+. PHP, IOP and OP programs that let you live at home, with free transportation and most insurance accepted, including Medicaid."
    stats={[
      { value: 'Joint Commission', label: 'Accredited' },
      { value: '50+', label: 'Years combined experience' },
      { value: 'Free', label: 'Transportation' },
      { value: 'Most', label: 'Insurance accepted' },
    ]}
  />

  <section class="section">
    <div class="container-x">
      <div class="max-w-3xl">
        <span class="eyebrow">West Palm Beach drug rehab</span>
        <h2 class="mt-3 text-3xl sm:text-4xl">Outpatient drug & alcohol treatment programs</h2>
        <p class="mt-5 text-lg text-charcoal">Sunview Wellness offers three levels of outpatient drug rehab in West Palm Beach. You receive intensive clinical treatment during the day or evening and go home at night, so what you learn gets tested in real life right away.</p>
      </div>
      <div class="mt-12"><ProgramCards /></div>
    </div>
  </section>

  <section class="section bg-mist">
    <div class="container-x">
      <div class="max-w-3xl">
        <span class="eyebrow">Drug & alcohol rehab</span>
        <h2 class="mt-3 text-3xl sm:text-4xl">Substances we treat in West Palm Beach</h2>
      </div>
      <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {SUBSTANCES.map((s) => (
          <div class="card">
            <h3 class="font-sans text-lg font-extrabold">{s.name}</h3>
            <p class="mt-2 text-charcoal">{s.blurb}</p>
          </div>
        ))}
      </div>
      <p class="mt-8"><a href="/substance-use-disorder/" class="inline-flex items-center gap-2 font-extrabold text-teal">More about substance use disorder treatment <Icon name="arrow" class="h-4 w-4" /></a></p>
    </div>
  </section>

  <section class="section">
    <div class="container-x">
      <div class="max-w-3xl">
        <span class="eyebrow">Why choose Sunview Wellness</span>
        <h2 class="mt-3 text-3xl sm:text-4xl">West Palm Beach’s outpatient drug rehab for lasting change</h2>
      </div>
      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {reasons.map((r) => (
          <div class="flex gap-4">
            <span class="inline-flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-mist text-teal"><Icon name={r.icon} class="h-6 w-6" /></span>
            <div>
              <h3 class="font-sans text-lg font-extrabold">{r.title}</h3>
              <p class="mt-1 text-charcoal">{r.text}</p>
            </div>
          </div>
        ))}
      </div>
      <div class="mt-14 grid gap-8 lg:grid-cols-2">
        <TelemedCard />
        <div class="rounded-[var(--radius-card)] border border-line p-8 sm:p-10">
          <p class="text-xs font-extrabold uppercase tracking-[0.16em] text-teal">A typical program day</p>
          <p class="mt-2 font-display text-2xl font-bold text-charcoal">9 AM – 1 PM, one continuous group</p>
          <ul class="mt-5 space-y-3 text-charcoal">
            <li class="flex gap-3"><Icon name="check" class="mt-1 h-5 w-5 shrink-0 text-teal-light" />One facilitator leads the whole morning (with breaks), so the group can go deeper instead of switching topics every hour.</li>
            <li class="flex gap-3"><Icon name="check" class="mt-1 h-5 w-5 shrink-0 text-teal-light" />A 45–60 minute individual session with your primary therapist every week, plus extra check-ins when something comes up.</li>
            <li class="flex gap-3"><Icon name="check" class="mt-1 h-5 w-5 shrink-0 text-teal-light" />Telemed Clinix appointments are scheduled for you and held in a private office on site.</li>
            <li class="flex gap-3"><Icon name="check" class="mt-1 h-5 w-5 shrink-0 text-teal-light" />Random drug testing as part of ongoing recovery support.</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <Accreditations />
  <InsuranceStrip title="Does your insurance cover drug rehab?" lead="Most major insurance plans cover outpatient drug and alcohol rehab. We verify your benefits at no cost before you begin treatment." />

  <section class="section">
    <div class="container-x grid gap-10 lg:grid-cols-[0.8fr_1.2fr]">
      <div>
        <span class="eyebrow">Drug rehab FAQ</span>
        <h2 class="mt-3 text-3xl sm:text-4xl">Before you start</h2>
      </div>
      <FaqList faqs={faqs} />
    </div>
  </section>

  <CtaBand title="Ready to start drug rehab in West Palm Beach?" />
</Base>
