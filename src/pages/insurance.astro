---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import LeadForm from '../components/LeadForm.astro';
import FaqList from '../components/FaqList.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import { INSURANCE } from '../data/site.js';

const faqs = [
  { q: 'Does insurance cover PHP, IOP and outpatient rehab?', a: 'In most cases, yes. Most health plans include behavioral health and substance use benefits that apply to outpatient levels of care. Exactly what’s covered depends on your plan, which is why we check before you start.' },
  { q: 'Do you accept Medicaid?', a: 'Yes, we accept Medicaid. Coverage details depend on your specific plan, and we’ll confirm yours before you start.' },
  { q: 'What do I need to verify my benefits?', a: 'Usually your name, date of birth and the member ID from your insurance card. You can start with just your name, phone and carrier, and we’ll call you for the rest.' },
  { q: 'My plan isn’t listed. Can you still help?', a: 'Very possibly. The logos shown are plans we commonly work with, not a complete list. Reach out and we’ll check.' },
  { q: 'Is transportation covered?', a: 'Transportation is free. If you can’t drive yourself, we arrange Uber Health rides to and from programming at no cost to you.' },
];
---
<Base
  title="Insurance for Rehab in West Palm Beach | Free Verification | Sunview Wellness"
  description="Sunview Wellness accepts most major insurance for outpatient rehab in West Palm Beach, including Medicaid, Aetna, Florida Blue, Cigna, UnitedHealthcare, Ambetter and Molina. Free, confidential benefits check."
  breadcrumbs={[{ name: 'Insurance', href: '/insurance/' }]}
  schema={[{ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) }]}
>
  <PageHero
    eyebrow="Insurance & payment"
    title="Find out what your plan covers,"
    accent="for free."
    lead="We accept most major insurance plans, including Medicaid. Share a few details and we’ll verify your benefits before you start, confidentially and with no obligation."
    compact
    showPhone
  >
    <Fragment slot="aside"><LeadForm formId="insurance-verify" dark heading="Free insurance verification" sub="Takes about a minute. We’ll call with your results." /></Fragment>
  </PageHero>

  <section class="section">
    <div class="container-x">
      <div class="max-w-3xl">
        <span class="eyebrow">Plans we work with</span>
        <h2 class="mt-3 text-3xl sm:text-4xl">Commonly accepted insurance</h2>
        <p class="mt-5 text-lg text-charcoal">Plus Medicaid and many others. Coverage varies by plan, so let us check yours.</p>
      </div>
      <ul class="mt-10 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-5">
        {INSURANCE.map((c) => (
          <li class="flex h-28 items-center justify-center rounded-2xl border border-line bg-white px-5">
            <img src={c.logo} alt={c.name} loading="lazy" class="max-h-14 w-auto max-w-full object-contain" />
          </li>
        ))}
        <li class="flex h-28 items-center justify-center rounded-2xl border border-line bg-mist px-5 text-center font-display text-xl font-bold text-charcoal">Medicaid</li>
      </ul>
    </div>
  </section>

  <section class="section bg-mist">
    <div class="container-x grid gap-10 lg:grid-cols-[0.8fr_1.2fr]">
      <div>
        <span class="eyebrow">Insurance FAQ</span>
        <h2 class="mt-3 text-3xl sm:text-4xl">Coverage questions</h2>
        <div class="mt-8 space-y-4">
          {['Free and confidential', 'No obligation to enroll', 'Results before you start'].map((t) => (
            <p class="flex items-center gap-3 font-bold text-charcoal"><Icon name="check-circle" class="h-5 w-5 text-teal" />{t}</p>
          ))}
        </div>
      </div>
      <FaqList faqs={faqs} />
    </div>
  </section>

  <CtaBand />
</Base>
