---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import SunMark from '../components/SunMark.astro';

// Content source: Clinical Director's answers, "Questionnaire for Website Content" (Q8–Q15, Q18, Q20–Q22).
// Scope notes from Q18: no formal EMDR service or certified art therapist, so don't advertise either.
const modalities = [
  { name: 'Internal Family Systems (IFS)', text: 'A shared foundation across the program. IFS runs through group topics, and therapists use it in individual sessions when clinically appropriate.' },
  { name: 'Psychodynamic therapy', text: 'Understanding the “why”: how past experiences and relationships still shape the way you think, feel and act today.' },
  { name: 'Inner child work', text: 'Working with the younger parts of you that still carry old beliefs, and learning to give yourself what was missing.' },
  { name: 'Psychodrama', text: 'An experiential method that puts important moments into action instead of only talking about them.' },
  { name: 'CBT', text: 'Recognizing and changing the thought patterns that have enabled addictive and problematic behavior.' },
  { name: 'DBT', text: 'Concrete skills for emotional regulation, distress tolerance and relationships.' },
  { name: 'Trauma-informed care', text: 'Every clinician is trauma-informed. Our lead therapist is EMDR-trained and may use EMDR-informed techniques in individual sessions when appropriate.' },
  { name: 'Expressive activities', text: 'Drawing, vision boards and other hands-on exercises offer another way into the work when clinically appropriate.' },
];

const phases = [
  { n: '01', title: 'Stabilization', text: 'Adjusting to the structure, establishing sobriety, managing cravings or symptoms, learning coping skills, and starting to feel safe enough to engage.' },
  { n: '02', title: 'Insight', text: 'As trust grows, the question shifts from “How do I get through this?” to “Why do I respond this way in the first place?”' },
  { n: '03', title: 'Integration', text: 'Moving from “I understand why I do this” to “I can see it happening, and I have a choice about how I respond.”' },
];

const measures = [
  { tool: 'Brief Addiction Monitor (BAM)', text: 'Tracks both risk and protective factors. We want to see the things that support recovery grow over time.' },
  { tool: 'PHQ-9 & GAD-7', text: 'Validated measures of depression and anxiety, repeated through treatment to show how symptoms change.' },
  { tool: 'Monthly treatment plan reviews', text: 'You and your therapist review progress toward your goals together and adjust the plan as you go.' },
  { tool: 'RSA-R client satisfaction survey', text: 'Your feedback on the program, which we review and use to make changes.' },
];
---
<Base
  title="Our Clinical Approach | IFS, Psychodynamic & In Vivo Treatment™ | Sunview Wellness"
  description="How Sunview Wellness treats addiction and co-occurring mental health: IFS, psychodynamic and inner child work, CBT, DBT, psychodrama, family involvement and In Vivo Treatment™ in West Palm Beach, FL."
  breadcrumbs={[{ name: 'Our Approach', href: '/our-approach/' }]}
>
  <PageHero
    eyebrow="The Sunview clinical model"
    title="We look beneath"
    accent="the tip of the iceberg."
    lead="The symptoms that bring someone into treatment are usually connected to deeper struggles that built up over time. Our work is understanding those layers, then turning that insight into real change."
    compact
  />

  <section class="section">
    <div class="container-x grid items-center gap-12 lg:grid-cols-[1.1fr_0.9fr]">
      <div>
        <span class="eyebrow">Why we go deeper</span>
        <h2 class="mt-3 text-3xl sm:text-4xl">Skills matter. They hold better when you know where the pain started.</h2>
        <div class="mt-6 space-y-4 text-lg text-charcoal">
          <p>Relapse prevention and coping skills are an important part of recovery, and we teach them. But without looking at where the triggers and thought patterns began, those tools can become a band-aid over a bullet hole.</p>
          <p>Too many people cycle in and out of treatment. We see the gaps in care that allow that, and we built our program to fill them. The goal isn’t to keep people in treatment indefinitely. It’s to help them build the insight, skills and inner resources to live well outside of it.</p>
        </div>
      </div>
      <figure class="rounded-[2rem] bg-cream p-10">
        <SunMark variant="sun" class="h-12 w-auto text-gold" />
        <blockquote class="mt-5 font-display text-2xl leading-snug text-charcoal">
          “Instead of asking ‘What is wrong with this person?’ I want to understand: What happened to this person? What have they learned? What patterns have they been living within?”
        </blockquote>
        <figcaption class="mt-5 text-sm"><strong class="text-charcoal">Dana Martin, Ph.D., LMFT</strong><br /><span class="text-charcoal">Clinical Director</span></figcaption>
      </figure>
    </div>
  </section>

  <section class="section bg-mist">
    <div class="container-x">
      <div class="max-w-3xl">
        <span class="eyebrow">Therapies & modalities</span>
        <h2 class="mt-3 text-3xl sm:text-4xl">A shared foundation, with room for each clinician’s strengths</h2>
        <p class="mt-5 text-lg text-charcoal">We don’t force one approach on every client, or on every therapist. The team shares a common clinical foundation while each clinician brings their own specialties and training.</p>
      </div>
      <ul class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {modalities.map((m) => (
          <li class="card">
            <h3 class="font-sans text-lg font-extrabold">{m.name}</h3>
            <p class="mt-2 text-sm text-charcoal">{m.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container-x grid gap-12 lg:grid-cols-2">
      <div>
        <span class="eyebrow">Psychodynamic & inner child work, in plain language</span>
        <h2 class="mt-3 text-3xl sm:text-4xl">Understanding the “why” behind what you do</h2>
        <div class="mt-6 space-y-4 text-lg text-charcoal">
          <p><strong class="text-charcoal">Psychodynamic therapy</strong> looks at how your past experiences, relationships and emotions may be shaping how you think, feel and behave today, often in patterns you aren’t fully aware of. That insight gives you more ability to make different choices.</p>
          <p><strong class="text-charcoal">Inner child work</strong> focuses on the younger parts of you that may still carry feelings of rejection, criticism, not feeling safe, or not being good enough. In therapy, we learn when those parts show up and how they influence you now. Then we practice “reparenting”: giving yourself the validation, compassion, boundaries and safety that may have been missing.</p>
          <p>The point isn’t just to understand the past. It’s shifting insight into action.</p>
        </div>
      </div>
      <div id="carefrontation" class="scroll-mt-28 rounded-[2rem] bg-teal p-8 text-white sm:p-12">
        <span class="eyebrow eyebrow-light">Group culture</span>
        <h2 class="mt-3 text-3xl text-white">“Carefrontation”</h2>
        <p class="mt-5 text-white/85">Caring about someone enough to have an honest, sometimes difficult conversation instead of telling them what they want to hear. It’s the balance between compassion and accountability.</p>
        <p class="mt-4 text-white/85">It’s never about shaming or attacking. Clients learn to give feedback grounded in what they’ve observed, and to receive it by pausing, listening and regulating before getting defensive. Clinicians model it and step in when feedback stops being helpful.</p>
        <p class="mt-6 border-l-4 border-sun pl-5 font-display text-xl text-white">We can hold someone accountable without taking away their dignity.</p>
      </div>
    </div>
  </section>

  <section class="section bg-cream">
    <div class="container-x">
      <div class="max-w-3xl">
        <span class="eyebrow">How the work evolves</span>
        <h2 class="mt-3 text-3xl sm:text-4xl">From stabilization, to insight, to integration</h2>
        <p class="mt-5 text-lg text-charcoal">We don’t rush anyone into uncovering something painful just because it’s there. Recovery isn’t linear, and hard days aren’t failures. They’re material we can learn from together.</p>
      </div>
      <ol class="mt-10 grid gap-6 md:grid-cols-3">
        {phases.map((p) => (
          <li class="card !bg-white">
            <p class="font-sans text-4xl font-extrabold text-teal">{p.n}</p>
            <h3 class="mt-2 text-2xl">{p.title}</h3>
            <p class="mt-3 text-charcoal">{p.text}</p>
          </li>
        ))}
      </ol>
      <div class="mt-10 rounded-[var(--radius-card)] border border-line bg-white p-8">
        <div class="grid items-center gap-6 md:grid-cols-[auto_1fr_auto]">
          <span class="inline-flex h-14 w-14 items-center justify-center rounded-2xl bg-mist text-teal"><Icon name="refresh" class="h-7 w-7" /></span>
          <div>
            <p class="font-display text-2xl font-bold text-charcoal">In Vivo Treatment™</p>
            <p class="mt-1 text-charcoal">Because you’re living at home, what you learn on Tuesday gets tested on Wednesday, with your spouse, at work, or in a hard conversation with family. You bring it back, we slow it down together, and you try again.</p>
          </div>
          <a href="/media/in-vivo-treatment-at-sunview-wellness-recovery-has-to-work-in-the-real-world/" class="btn-ghost shrink-0">Read more</a>
        </div>
      </div>
    </div>
  </section>

  <section id="family" class="section scroll-mt-28">
    <div class="container-x grid gap-12 lg:grid-cols-2">
      <div>
        <span class="eyebrow">Families & a systems lens</span>
        <h2 class="mt-3 text-3xl sm:text-4xl">Nobody exists in isolation, and neither does addiction</h2>
        <div class="mt-6 space-y-4 text-lg text-charcoal">
          <p>Our Clinical Director is a couple and family therapist, and that systems-based training shapes the whole program. Every person in a family plays a role in how the system works, even when those patterns aren’t healthy. If we only treat the individual symptom, we can miss the system that keeps reinforcing it.</p>
          <p>We don’t believe anyone is born “bad” or destined to struggle. People are shaped by their experiences, relationships and environments, and they can create something different.</p>
        </div>
      </div>
      <div class="card !p-8 sm:!p-10">
        <h3 class="text-2xl">What family involvement looks like</h3>
        <ul class="mt-6 space-y-4">
          <li class="flex gap-3"><Icon name="check-circle" class="mt-1 h-5 w-5 shrink-0 text-teal" /><span><strong class="text-charcoal">First week:</strong> your therapist reaches out to a loved one you’ve approved, to introduce themselves and hear what they think the team should know.</span></li>
          <li class="flex gap-3"><Icon name="check-circle" class="mt-1 h-5 w-5 shrink-0 text-teal" /><span><strong class="text-charcoal">Ongoing:</strong> weekly phone or email updates and family sessions every two weeks or monthly, depending on clinical need.</span></li>
          <li class="flex gap-3"><Icon name="check-circle" class="mt-1 h-5 w-5 shrink-0 text-teal" /><span><strong class="text-charcoal">Always your call:</strong> if you’re hesitant, we won’t pressure you. We’ll explore what’s underneath the hesitation, and involvement can grow as treatment goes on.</span></li>
        </ul>
      </div>
    </div>
  </section>

  <section id="outcomes" class="section scroll-mt-28 bg-mist">
    <div class="container-x">
      <div class="max-w-3xl">
        <span class="eyebrow">Measuring progress</span>
        <h2 class="mt-3 text-3xl sm:text-4xl">Success is more than finishing a program</h2>
        <p class="mt-5 text-lg text-charcoal">We look for meaningful, lasting change: more stability, insight and engagement in recovery, and stronger protective factors. We measure it along the way.</p>
      </div>
      <ul class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {measures.map((m) => (
          <li class="card">
            <Icon name="chart" class="h-6 w-6 text-teal" />
            <h3 class="mt-4 font-sans text-lg font-extrabold">{m.tool}</h3>
            <p class="mt-2 text-sm text-charcoal">{m.text}</p>
          </li>
        ))}
      </ul>
      <div class="mt-10 grid gap-6 lg:grid-cols-2">
        <div class="rounded-[var(--radius-card)] bg-white p-8">
          <h3 class="text-2xl">After you complete treatment</h3>
          <p class="mt-3 text-charcoal">We follow up with alumni to see how they’re doing, whether they’re still connected to the supports recommended at discharge, and where we can strengthen our discharge planning. You can also keep your Telemed Clinix psychiatric provider after you leave.</p>
        </div>
        <div class="rounded-[var(--radius-card)] bg-white p-8">
          <h3 class="text-2xl">Gender-specific groups</h3>
          <p class="mt-3 text-charcoal">On regular gender-specific group days, women and men meet in separate groups. It adds another layer of safety for topics that can be harder to raise in a mixed group.</p>
        </div>
      </div>
    </div>
  </section>

  <CtaBand title="See if our approach is the right fit" lead="Call and talk it through with our team. There’s no pressure, just an honest conversation about what you need." />
</Base>
