---
// /about/: About-Team-Content-Briefs.md §C. Sources and open items in docs/content/about-team-sources-about.md.
// No reviewed-by byline (brief decision). Rotation: Reviews + Map. Accreditation logos in the hero (ServicePage default).
// Schema: MedicalOrganization + BreadcrumbList come from Base (#organization); this page adds AboutPage
// (about/mainEntity point at #organization, no duplicate org node) + FAQPage from the visible questions.
import ServicePage from '../../layouts/ServicePage.astro';
import Icon from '../../components/Icon.astro';
import SunMark from '../../components/SunMark.astro';
import { SITE, ACCREDITATIONS, initials } from '../../data/site.js';
import { PUBLISHED_PEOPLE } from '../../data/team.js';
import { pageSchema } from '../../lib/programSchema.js';

const path = '/about/';
const metaTitle = 'About Sunview Wellness | Outpatient Rehab in West Palm Beach';
const description =
  'Founded in 2021 and Joint Commission accredited, Sunview Wellness offers outpatient PHP, IOP and OP in West Palm Beach, built for real life.';

// Mission, Vision and Values: VERBATIM from the Client Wiki (2026-09-22, "Brand Introduction", wiki txt
// lines 308–328). Only changes: em dashes → commas/colon, ↗ markers dropped, closing periods added.
const mvv: { key: string; label: string; icon: string; text: string | string[] }[] = [
  {
    key: 'mission',
    label: 'Mission',
    icon: 'compass',
    text: 'To give the local community access to quality extended care, the “stay sober” half of treatment, regardless of payer, so that great treatment isn’t only for people with Cadillac insurance policies and a lot of cash.',
  },
  {
    key: 'vision',
    label: 'Vision',
    icon: 'sparkle',
    text: 'To be the best standalone PHP, IOP and outpatient program in Palm Beach County: a facility known for Sunview’s own reputation rather than for individual people, that stands out from the South Florida treatment landscape instead of blending into it.',
  },
  {
    key: 'values',
    label: 'Values',
    icon: 'heart',
    text: [
      'Outcomes over bulk billing: clinical architecture built around accountability, connection, structure and sustainable recovery rather than short-term stabilization',
      'Access for everyone, not just commercial policies',
      'A strong culture of recovery',
      'Intentional, quality-first clinical hiring',
      'Visibility and open communication across every level of the organization',
    ],
  },
];

// USPs 1–4: Client Wiki (wiki txt lines 191–210), as close to verbatim as the copy rules allow. Removed: the
// length-of-stay sentence in USP 1 (answer 8.6), em dashes, "clients" → "people", "mandated-client" →
// "mandated" (the "door-to-door" wording was restored by the Decisions of 2026-09-24), USP 2's closing "Cadillac" clause (kept in the Mission above), and USP 4's
// source note. The short titles are ours. Every deviation is logged in about-team-sources-about.md.
const usps = [
  { title: 'A true standalone program', html: 'A true standalone PHP/IOP/OP extended care program, “a dying breed” locally, built for the person who works and lives locally and needs flexibility rather than luxury housing or a six-month sober living funnel.' },
  { title: 'In network with nearly every carrier', html: 'In network with virtually every insurance carrier there is, including Medicaid, which the majority of local competitors are not.' },
  { title: 'In vivo, with clinical depth behind it', html: 'The “in vivo” model with genuine clinical depth behind it: Joint Commission accredited, a PhD-led clinical team with 50+ years combined experience, intentionally built rather than mandated group-think, plus free door-to-door transportation and psychiatric medication management via the Telemed Clinix partnership, so people can recover while working, parenting and living at home.' },
  { title: 'A named clinical model', html: 'A named clinical model rather than generic outpatient care. The team works psychodynamically and uses <a href="/therapies/inner-child-therapy/">Inner Child Therapy</a> as an integrative modality, working on the shame, inadequacy and fear underneath the substance use rather than the symptoms sitting on top of it.' },
];

// Outpatient model contrast rows: LIVE /, Frank's "Recovery Doesn't Happen in a Bubble" (posts.js), the In
// Vivo Treatment™ article, Q2/Q3/Q5.
const model = [
  { not: 'A residential bubble you eventually have to leave', is: 'You live at home and sleep in your own bed every night' },
  { not: 'Housing arranged by the program', is: 'No housing: your real home, family and routines stay part of the picture' },
  { not: '“What would you do if a craving hit?”', is: '“What actually happened when the craving hit yesterday?”' },
  { not: 'Skills that only exist on paper', is: 'Skills you practice at work and at home, then bring back to group' },
];

const measures = [
  { abbr: 'BAM', name: 'Brief Addiction Monitor', text: 'Looks at risk and protective factors in substance use, recovery and overall functioning. We want to see protective factors grow.' },
  { abbr: 'PHQ-9', name: 'Depression measure', text: 'Tracks symptoms of depression over the course of treatment.' },
  { abbr: 'GAD-7', name: 'Anxiety measure', text: 'Tracks symptoms of anxiety over the course of treatment.' },
  { abbr: 'RSA-R', name: 'Satisfaction survey', text: 'Your feedback on the program, which we review and use to make changes.' },
];

// Decorative initials for the published team roster (team.js; people with publish: false stay out).
const roster = PUBLISHED_PEOPLE.map((p) => initials(p.name));

const addr = `${SITE.address.street}, ${SITE.address.city}, ${SITE.address.region} ${SITE.address.postal}`;
const seal = ACCREDITATIONS[0];

const faqs = [
  { q: 'Is Sunview a residential facility?', a: 'Sunview is outpatient care: PHP, IOP and OP. You sleep at home every night. If you need detox, housing or 24-hour care first, we’ll help you find it and plan your step down to us. <a href="/programs/">Compare our levels of care</a>.' },
  { q: 'Are you accredited?', a: 'Yes. Sunview Wellness is accredited by The Joint Commission.' },
  { q: 'Who is Sunview for?', a: 'Adults 18 and older living with substance use, often alongside mental health conditions like anxiety, depression or trauma. Many people come to us after detox or residential treatment; others start from home because they, or someone who cares about them, see that more help is needed. <a href="/admissions/">How admissions works</a>.' },
  { q: 'Do you treat mental health on its own?', a: 'We treat mental health conditions alongside substance use, in our PHP, IOP and OP programs, with therapy and psychiatric care in one plan. If you’re looking for mental health care on its own, we’ll help you find the right fit. <a href="/what-we-treat/mental-health/">Mental health conditions we treat</a>.' },
  { q: 'Where are you located?', a: `${addr}. Free door-to-door transportation is available if you can’t drive yourself.` },
];

// AboutPage about the organization (a reference to Base's #organization, no duplicate org node) + FAQPage.
const org = { '@id': `${SITE.url}/#organization` };
const schema = pageSchema({ path, title: metaTitle, description, faqs, pageType: 'AboutPage', extra: { about: org, mainEntity: org } });

const link = 'font-bold text-teal underline decoration-2 underline-offset-4 hover:text-teal-light';
---
<ServicePage
  path={path}
  ctaTitle="Talk with our team before you decide."
  metaTitle={metaTitle}
  description={description}
  crumbs={[{ name: 'About', href: '/about/' }]}
  h1="About Sunview Wellness in West Palm Beach"
  subheading="Your Community. Your Recovery."
  lead="Sunview Wellness is an outpatient program for adults 18 and older. We work only at the PHP, IOP and OP levels of care, so you live at home while you get better, and real life becomes part of the work."
  faqTitle="Frequently Asked Questions About Sunview Wellness"
  faqs={faqs}
  reviews
  map
  schema={schema}
>
  {/* 1. Mission, Vision and Values: open triptych with gold rules (verbatim Client Wiki text) */}
  <section class="section">
    <div class="container-x">
      <div class="mx-auto max-w-3xl text-center">
        <h2 class="text-3xl sm:text-[2.1875rem]">Our Mission, Vision and Values</h2>
        <p class="subheading mt-3">What we’re here to do, and how we do it</p>
      </div>
      <div class="mt-12 grid gap-10 md:grid-cols-3 md:gap-0">
        {mvv.map((m, i) => (
          <article class:list={['md:px-8 lg:px-12', i > 0 && 'border-t border-line pt-10 md:border-l-2 md:border-t-0 md:border-l-gold/60 md:pt-0']} data-wiki={m.key}>
            <span class="inline-flex h-12 w-12 items-center justify-center rounded-full bg-mist text-teal"><Icon name={m.icon} class="h-6 w-6" /></span>
            <h3 class="mt-5 text-[1.75rem]">{m.label}</h3>
            {Array.isArray(m.text) ? (
              <ul class="mt-4 space-y-2 text-lg">
                {m.text.map((v) => <li class="flex items-start gap-3"><Icon name="check" class="mt-1.5 h-4 w-4 shrink-0 text-teal" />{v}</li>)}
              </ul>
            ) : (
              <p class="mt-4 text-lg">{m.text}</p>
            )}
          </article>
        ))}
      </div>
    </div>
  </section>

  {/* 2. A true outpatient model: "instead of / at Sunview" contrast rows on cream */}
  <section class="section bg-cream">
    <div class="container-x grid gap-12 lg:grid-cols-[0.85fr_1.15fr]">
      <div>
        <h2 class="text-3xl sm:text-[2.1875rem]">A True Outpatient Model for Real Life</h2>
        <p class="subheading mt-3">Sobriety isn’t proven in treatment. It’s proven in life.</p>
        <div class="mt-6 space-y-4 text-lg">
          <p>Sunview operates only at the PHP, IOP and OP levels of care, and the people we treat live in their own homes and communities. We don’t offer housing, and that’s on purpose: recovery doesn’t happen in a bubble.</p>
          <p>Through In Vivo Treatment™, you learn a skill, apply it in your everyday life, bring back what happened, and adjust with your therapist and your group. The argument at home or the hard day at work becomes material we work with the next morning.</p>
        </div>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/programs/" class="btn-teal">Compare our outpatient programs <Icon name="arrow" /></a>
        </div>
      </div>
      <div class="rounded-[var(--radius-lg)] bg-white p-6 ring-1 ring-line sm:p-8">
        <div class="hidden grid-cols-2 gap-6 border-b border-line pb-4 font-sans text-[13px] font-extrabold uppercase tracking-[0.08em] sm:grid">
          <p class="text-muted">Instead of</p>
          <p class="text-teal">At Sunview</p>
        </div>
        <ul class="divide-y divide-line">
          {model.map((r) => (
            <li class="grid gap-2 py-5 sm:grid-cols-2 sm:gap-6">
              <p class="text-muted"><span class="sr-only">Instead of: </span><span class="mr-2 font-sans text-[12px] font-extrabold uppercase tracking-[0.08em] sm:hidden" aria-hidden="true">Instead of</span><span class="line-through decoration-gold/70 decoration-2">{r.not}</span></p>
              <p class="flex items-start gap-3 font-bold text-charcoal"><Icon name="arrow" class="mt-1 h-4 w-4 shrink-0 text-teal" /><span><span class="sr-only">At Sunview: </span>{r.is}</span></p>
            </li>
          ))}
        </ul>
        <p class="mt-5 text-[15px]">Stepping down from detox or residential care? That’s where most people start with us. <a href="/admissions/what-to-expect/" class={link}>What to expect in treatment</a>.</p>
      </div>
    </div>
    {/* USPs 1–4 (Client Wiki), numbered row under the contrast grid */}
    <ol class="container-x mt-14 grid gap-8 md:grid-cols-2 lg:grid-cols-4">
      {usps.map((u, i) => (
        <li class="border-t-2 border-gold pt-6">
          <span class="font-sans text-sm font-extrabold text-teal" aria-hidden="true">0{i + 1}</span>
          <h3 class="mt-2 text-xl">{u.title}</h3>
          <p class="prose-sv mt-3 text-[15px]" set:html={u.html} />
        </li>
      ))}
    </ol>
  </section>

  {/* 3. Founded in 2021: full-bleed teal milestone band with an oversized year */}
  <section class="relative isolate overflow-hidden bg-teal py-14 text-white sm:py-20">
    <SunMark variant="waves" class="pointer-events-none absolute -bottom-10 -left-10 -z-10 h-[260px] w-[260px] text-white/10" />
    <div class="container-x grid items-center gap-10 lg:grid-cols-[auto_1fr_auto] lg:gap-14">
      <p class="font-display text-[5.5rem] font-extrabold leading-none text-sun sm:text-[8rem]" aria-hidden="true">2021</p>
      <div>
        <h2 class="text-3xl text-white sm:text-[2.1875rem]">Founded in 2021, Formerly Sunview Medical Center</h2>
        <p class="mt-5 max-w-[64ch] text-lg text-white/90">Sunview Wellness opened in West Palm Beach in 2021, and you may know us by our former name, Sunview Medical Center. Today we’re a Joint Commission accredited outpatient center for adults 18 and older, treating substance use and co-occurring mental health conditions at 4802 East Ave, close to home for people across Palm Beach County.</p>
        <ul class="mt-7 flex flex-wrap gap-2.5">
          {['Founded 2021', 'Joint Commission accredited', 'Adults 18+', 'West Palm Beach, FL'].map((c) => (
            <li class="rounded-full border border-white/35 px-4 py-1.5 font-sans text-sm font-bold text-white">{c}</li>
          ))}
        </ul>
      </div>
      <img src={seal.logoOnDark} alt="The Joint Commission accreditation seal" width={seal.w} height={seal.h} class="h-28 w-28 sm:h-32 sm:w-32" />
    </div>
  </section>

  {/* 4. The people: avatar stack + one big figure, then a single link */}
  <section class="section">
    <div class="container-x grid items-center gap-12 lg:grid-cols-[1fr_1fr]">
      <div>
        <h2 class="text-3xl sm:text-[2.1875rem]">The People Behind the Program</h2>
        <p class="subheading mt-3">Licensed, trauma-informed and PhD-led</p>
        <p class="mt-5 max-w-[60ch] text-lg">Our multidisciplinary team brings over 50 years of combined clinical experience: licensed therapists, social workers, certified addiction professionals and group facilitators. Our Clinical Director, Dana Martin, Ph.D., LMFT, reviews every pre-screening, and every clinician is trauma-informed. Psychiatric medication management comes through our partner, Telemed Clinix.</p>
        <a href="/our-team/" class="btn-ghost mt-8">Meet our treatment team</a>
      </div>
      <div>
        <div class="rounded-[var(--radius-lg)] border border-line p-8 sm:p-10">
          <p class="font-display text-6xl font-extrabold leading-none text-teal sm:text-7xl">50+</p>
          <p class="mt-2 font-sans text-lg font-extrabold text-charcoal">years of combined clinical experience</p>
          <ul class="mt-8 flex" aria-hidden="true">
            {roster.map((r, i) => (
              <li class:list={['-ml-1.5 first:ml-0 h-11 w-11 items-center justify-center rounded-full font-sans text-sm font-extrabold ring-4 ring-white sm:-ml-2 sm:h-14 sm:w-14 sm:text-base', i >= 6 ? 'hidden sm:inline-flex' : 'inline-flex', i % 3 === 0 ? 'bg-teal text-white' : i % 3 === 1 ? 'bg-mist text-teal' : 'bg-cream text-charcoal']}>{r}</li>
            ))}
            <li class="-ml-1.5 inline-flex h-11 w-11 items-center justify-center rounded-full bg-white font-sans text-sm font-extrabold text-teal ring-4 ring-white outline outline-1 outline-line sm:hidden">+{roster.length - 6}</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  {/* 5. Measures: typographic stat row on mist, abbreviations as the "numbers" */}
  <section class="section bg-mist">
    <div class="container-x">
      <div class="grid gap-6 lg:grid-cols-[1fr_1fr] lg:items-end">
        <div>
          <h2 class="text-3xl sm:text-[2.1875rem]">How We Measure What Matters</h2>
          <p class="subheading mt-3">Progress is more than finishing a program</p>
        </div>
        <p class="text-lg lg:pb-1">We want to see real progress in the areas that brought you in, along with more stability, insight and engagement in your recovery. So we track it, with validated tools and with your own feedback.</p>
      </div>
      <dl class="mt-12 grid border-y-2 border-teal/25 sm:grid-cols-2 lg:grid-cols-4">
        {measures.map((m, i) => (
          <div class:list={['flex flex-col-reverse py-8 sm:px-6', i > 0 && 'border-t border-line sm:border-t-0', i % 2 === 1 && 'sm:border-l sm:border-line', i >= 2 && 'sm:border-t lg:border-t-0', i === 2 && 'lg:border-l lg:border-line']}>
            <dd class="mt-3 text-[15px]">{m.text}</dd>
            <dt>
              <span class="block font-sans text-[2.5rem] font-extrabold leading-none text-teal">{m.abbr}</span>
              <span class="mt-2 block font-sans text-sm font-extrabold uppercase tracking-[0.08em] text-charcoal">{m.name}</span>
            </dt>
          </div>
        ))}
      </dl>
      <p class="mt-8 max-w-[70ch] text-lg">Your therapist also reviews your treatment plan with you every month, to look at your goals and adjust what isn’t working. <a href="/about/our-approach/" class={link}>How we measure progress in our clinical approach</a>.</p>
    </div>
  </section>

  {/* 6. Serving West Palm Beach: address "ticket" + fact rows, no map here (the Map block follows the reviews) */}
  <section class="section">
    <div class="container-x grid items-start gap-12 lg:grid-cols-[1.1fr_0.9fr]">
      <div>
        <h2 class="text-3xl sm:text-[2.1875rem]">Serving West Palm Beach and Palm Beach County</h2>
        <p class="subheading mt-3">Getting here shouldn’t be the obstacle</p>
        <p class="mt-5 max-w-[62ch] text-lg">Our center is in West Palm Beach and serves people across Palm Beach County. Programming runs in the morning, with an evening IOP after work, so you can keep your job and sleep in your own bed.</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/locations/west-palm-beach/" class="btn-teal">Our West Palm Beach location <Icon name="arrow" /></a>
          <a href="/admissions/" class="btn-ghost">How admissions works</a>
        </div>
      </div>
      <ul class="overflow-hidden rounded-[var(--radius-lg)] border border-line">
        <li class="flex items-start gap-4 bg-teal p-6 text-white">
          <Icon name="pin" class="mt-0.5 h-6 w-6 shrink-0 text-sun" />
          <div>
            <p class="font-sans font-extrabold">Sunview Wellness</p>
            <a href={SITE.mapsUrl} target="_blank" rel="noopener" class="text-white/90 hover:text-white hover:underline">{addr}</a>
          </div>
        </li>
        <li class="flex items-start gap-4 border-t border-line p-6">
          <Icon name="car" class="mt-0.5 h-6 w-6 shrink-0 text-teal" />
          <div>
            <p class="font-sans font-extrabold text-charcoal">Free door-to-door transportation</p>
            <p class="mt-1">Free door-to-door transportation to and from our center if you can’t drive yourself.</p>
          </div>
        </li>
        <li class="flex items-start gap-4 border-t border-line p-6">
          <Icon name="message" class="mt-0.5 h-6 w-6 shrink-0 text-teal" />
          <div>
            <p class="font-sans font-extrabold text-charcoal">English and Spanish</p>
            <p class="mt-1">Individual sessions in English or Spanish with one of our two bilingual therapists. Groups are in English.</p>
          </div>
        </li>
        <li class="flex items-start gap-4 border-t border-line p-6">
          <Icon name="phone" class="mt-0.5 h-6 w-6 shrink-0 text-teal" />
          <div>
            <p class="font-sans font-extrabold text-charcoal">Call admissions</p>
            <a href={SITE.phoneHref} class="mt-1 inline-block font-sans text-xl font-extrabold text-teal hover:text-teal-light">{SITE.phone}</a>
          </div>
        </li>
      </ul>
    </div>
  </section>
</ServicePage>
