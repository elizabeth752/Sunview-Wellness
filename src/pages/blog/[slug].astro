---
// Post template (/blog/{slug}/), per docs/content/SOP-Blog-Post-Author-Templates.md §2.
// Banner (Home hero look, no form): breadcrumb, H1, then author (left) and category · date · Share on (right).
// Body ≥1024px: article + sticky sidebar (ToC from the article's H2s, mini CTA, insurance carousel, one Google
// review, related posts). <1024px: no sidebar; a "Table of contents" button opens a drawer; the call CTA is the
// sitewide bottom call bar; insurance, review and related render after the article.
// End of the article: Sources (only real references) · Share on · author mini-card (<1024px only). Latest articles
// is a full-width section below the article + sidebar block (QA batch 11 item 8). Every post has a `body` with ≥2 H2s.
// Podcasts: lazy YouTube facade first (poster = YouTube thumbnail, 16:9, loads only on click), then the body.
// Author = reference into src/data/team.js (postAuthor). Feature graphic = og:image (scripts/generate-post-graphics.mjs).
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import CtaBand from '../../components/CtaBand.astro';
import Icon from '../../components/Icon.astro';
import Avatar from '../../components/Avatar.astro';
import PostCard from '../../components/PostCard.astro';
import ShareLinks from '../../components/ShareLinks.astro';
import InsuranceCarousel from '../../components/InsuranceCarousel.astro';
import ReviewCard from '../../components/ReviewCard.astro';
import TocList from '../../components/toc/TocList.astro';
import TocDrawer from '../../components/toc/TocDrawer.astro';
import { SITE } from '../../data/site.js';
import { REVIEWS } from '../../data/reviews.js';
import {
  posts, formatDate, postAuthor, postUrl, postOgImage, postUpdated,
  latestPosts, relatedPosts, categoryColor, durationIso,
} from '../../data/posts.js';

export function getStaticPaths() {
  return posts.map((post, index) => ({ params: { slug: post.slug }, props: { post, index } }));
}

const { post, index } = Astro.props;
const url = new URL(postUrl(post), SITE.url).href;
const author = postAuthor(post);
const authorUrl = new URL(author.href, SITE.url).href;
const ogImage = postOgImage(post);
// <title> ≤60 chars (answer 9.1): seoTitle when the article title itself is too long; otherwise the
// article title plus the longest brand suffix that fits. The visible H1 always uses post.title.
const metaTitle =
  post.seoTitle ??
  [`${post.title} | Sunview Wellness`, `${post.title} | Sunview`, post.title].find((t) => t.length <= 60) ??
  post.title;
const related = relatedPosts(post, 3);
const latest = latestPosts(post, 3);

// Bio excerpts, both from the one team.js record (QA batch 11 items 6, 7, 18): byline ≈2 lines, mini-card ≈5 lines.
// Cut in the HTML too (not only visually), so the full bio lives on the person page only.
const bioWords = author.bio.join(' ').split(/\s+/);
const excerpt = (n: number) => (bioWords.length > n ? `${bioWords.slice(0, n).join(' ').replace(/[,.;:]$/, '')}…` : bioWords.join(' '));
const bylineBio = excerpt(26);
const cardBio = excerpt(60);

// Article body: give every H2 an id for the table of contents (H2s only)
const slugify = (s: string) =>
  s.replace(/<[^>]+>/g, '').toLowerCase().normalize('NFKD').replace(/[^\w\s-]/g, '').trim().replace(/[\s_]+/g, '-').replace(/-+/g, '-');
const toc: { id: string; text: string }[] = [];
const body: string = post.body.replace(/<h2>([\s\S]*?)<\/h2>/g, (_: string, inner: string) => {
      let id = slugify(inner);
      while (toc.some((t) => t.id === id)) id += '-2';
      toc.push({ id, text: inner.replace(/<[^>]+>/g, '') });
      return `<h2 id="${id}" tabindex="-1" class="toc-target">${inner}</h2>`;
    });
const hasToc = toc.length >= 2;

// One verbatim Google review: the featured short ones, alternating by post
const reviewPool = REVIEWS.filter((r) => r.featured && r.text.length <= 450);
const review = reviewPool[index % reviewPool.length];

const schemaNode: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  '@id': `${url}#article`,
  headline: post.title,
  description: post.metaDescription ?? post.dek,
  image: new URL(ogImage, SITE.url).href,
  datePublished: post.date,
  dateModified: postUpdated(post),
  author: { '@type': 'Person', '@id': `${authorUrl}#person`, name: author.name, url: authorUrl, jobTitle: author.title },
  publisher: { '@id': `${SITE.url}/#organization` },
  mainEntityOfPage: { '@type': 'WebPage', '@id': url },
  articleSection: post.category,
  inLanguage: 'en-US',
};
if (post.type === 'video') {
  schemaNode.video = {
    '@type': 'VideoObject',
    name: post.title,
    description: post.metaDescription ?? post.dek,
    thumbnailUrl: `https://i.ytimg.com/vi/${post.youtube}/hqdefault.jpg`,
    uploadDate: post.uploadDate,
    duration: durationIso(post),
    embedUrl: `https://www.youtube.com/embed/${post.youtube}`,
    contentUrl: `https://www.youtube.com/watch?v=${post.youtube}`,
  };
}
const crumbs = [{ name: 'Blog', href: '/blog/' }, { name: post.title, href: postUrl(post) }];
const label = 'text-[13px] font-extrabold uppercase tracking-[0.08em] text-muted';
const cardCls = 'rounded-[var(--radius-card)] bg-white p-6';
---
<Base
  title={metaTitle}
  description={post.metaDescription ?? post.dek}
  image={ogImage}
  type="article"
  breadcrumbs={crumbs}
  schema={[schemaNode]}
>
  {/* H1 kept to the article column's width at ≥1024px (QA batch 11 item 10) */}
  <div class="sv-post-hero">
  <PageHero title={post.title} crumbs={crumbs} actions={false} banner>
    <Fragment slot="below">
      <div class="mt-8 grid gap-6 border-t border-white/20 pt-7 lg:mt-10 lg:grid-cols-[minmax(0,1fr)_340px] lg:gap-[30px] lg:pt-9">
        {/* Compact byline (QA batch 11 item 6): 65px photo, name + credentials + role on one line, 2-line bio, Read more.
            Below 1024px: photo + name + role only (SOP §2). */}
        <div class="flex items-center gap-4 lg:items-start">
          <Avatar person={author} class="h-[65px] w-[65px]" text="text-xl" />
          <div class="min-w-0">
            <p class="leading-snug">
              <a href={author.href} class="font-display text-lg font-bold text-white hover:underline">{author.name}</a><span class="hidden text-sm font-bold text-white/80 lg:inline">, {author.creds}</span>
              <span class="text-[15px] text-white/85"><span aria-hidden="true"> · </span>{author.role}</span>
            </p>
            <p class="mt-1.5 hidden max-w-[70ch] text-[15px] leading-relaxed text-white/85 lg:line-clamp-2">{bylineBio}</p>
            <a href={author.href} class="mt-1.5 hidden items-center gap-1 text-sm font-extrabold text-white underline decoration-gold decoration-2 underline-offset-4 hover:decoration-white lg:inline-flex" aria-label={`Read more about ${author.name}`}>Read more <span aria-hidden="true">→</span></a>
          </div>
        </div>
        {/* Category · date · share */}
        <div class="flex flex-col gap-4 lg:border-l lg:border-white/20 lg:pl-8">
          <dl class="flex flex-wrap gap-x-10 gap-y-3">
            <div>
              <dt class="text-[13px] font-extrabold uppercase tracking-[0.08em] text-white/70">Category</dt>
              <dd class="mt-1 inline-flex items-center gap-2 font-bold text-white">
                <span class="h-2.5 w-2.5 rounded-full" style={`background:${categoryColor(post.category).accent}`} aria-hidden="true"></span>{post.category}
              </dd>
            </div>
            <div>
              <dt class="text-[13px] font-extrabold uppercase tracking-[0.08em] text-white/70">Published</dt>
              <dd class="mt-1 font-bold text-white"><time datetime={post.date}>{formatDate(post.date)}</time></dd>
            </div>
          </dl>
          <ShareLinks url={url} title={post.title} tone="dark" />
        </div>
      </div>
      {/* One-line origin note (not a source): "Originally published on LinkedIn" · "Watch on YouTube" · "Watch the clip" */}
      {post.note && (
        <p class="mt-6 text-[15px] leading-relaxed text-white/85">
          <Icon name={post.type === 'article' ? 'linkedin' : post.type === 'video' ? 'youtube' : 'play'} class="mr-1.5 inline-block h-4 w-4 -translate-y-px align-middle text-gold" />
          {post.note.text && <>{post.note.text}<span aria-hidden="true"> · </span></>}
          <a href={post.note.url} target="_blank" rel="noopener" class="whitespace-nowrap font-extrabold text-white underline decoration-gold decoration-2 underline-offset-4 hover:decoration-white">{post.note.linkText}<Icon name="external" class="ml-1 inline-block h-3.5 w-3.5 align-middle" /><span class="sr-only"> (opens in a new tab)</span></a>
        </p>
      )}
    </Fragment>
  </PageHero>
  </div>

  {/* <1024px: table of contents drawer trigger (closed by default) */}
  {hasToc && (
    <div class="border-b border-line bg-white lg:hidden">
      <TocDrawer items={toc} class="container-x py-3" />
    </div>
  )}

  <div class="bg-mist py-10 sm:py-14 lg:pb-12 lg:pt-16">
    <div class="container-x lg:grid lg:grid-cols-[minmax(0,1fr)_340px] lg:items-start lg:gap-[30px]">
      <div class="min-w-0">
        <article class="rounded-[var(--radius-lg)] bg-white p-6 sm:p-10 xl:p-14" data-article>
          {post.type === 'video' && (
            <div class="yt-facade relative mb-10 aspect-video overflow-hidden rounded-[var(--radius-card)] bg-teal" data-yt={post.youtube} data-title={post.title}>
              <img src={`https://i.ytimg.com/vi/${post.youtube}/hqdefault.jpg`} alt="" width="480" height="360" loading="lazy" class="h-full w-full object-cover" />
              <button type="button" class="absolute inset-0 flex items-center justify-center bg-teal/20 transition hover:bg-teal/10" aria-label={`Play video: ${post.title}`}>
                <span class="inline-flex h-20 w-20 items-center justify-center rounded-full bg-sun text-charcoal shadow-xl"><Icon name="play" class="ml-1 h-9 w-9" /></span>
              </button>
            </div>
          )}

          <div class="prose-sv sv-article" set:html={body} />

          {/* End of article: Sources · Share on · author mini-card (<1024px) */}
          <div class="mt-12 space-y-8 border-t border-line pt-8">
            {post.sources?.length > 0 && (
              <section aria-labelledby="sources-title">
                <h2 id="sources-title" class="font-sans text-[13px] font-extrabold uppercase tracking-[0.08em] text-muted">Sources</h2>
                <ol class="mt-3 list-decimal space-y-2 pl-5 text-[15px] leading-relaxed marker:font-bold marker:text-teal">
                  {post.sources.map((s: { label: string; url?: string }) => (
                    <li>{s.url
                      ? <a href={s.url} target="_blank" rel="nofollow noopener" class="font-semibold text-teal underline decoration-teal-light decoration-2 underline-offset-4 hover:text-teal-light">{s.label}</a>
                      : s.label}</li>
                  ))}
                </ol>
              </section>
            )}
            <ShareLinks url={url} title={post.title} />
            <aside class="flex flex-col gap-5 rounded-[var(--radius-card)] bg-cream p-6 sm:flex-row sm:p-8 lg:hidden" aria-label="About the author" data-author-card>
              <Avatar person={author} class="h-20 w-20" text="text-2xl" />
              <div class="min-w-0">
                <span class={label}>About the author</span>
                <p class="mt-1 font-display text-xl font-bold text-charcoal"><a href={author.href} class="hover:text-teal">{author.name}</a><span class="font-sans text-sm font-bold text-muted">, {author.creds}</span></p>
                <p class="text-[15px] font-bold text-teal">{author.role}</p>
                <p class="mt-3 line-clamp-5 text-[15px] leading-relaxed">{cardBio}</p>
                <a href={author.href} class="mt-3 inline-flex items-center gap-1 text-sm font-extrabold text-teal hover:text-teal-light" aria-label={`Read more about ${author.name}`}>Read more <span aria-hidden="true">→</span></a>
              </div>
            </aside>
          </div>
        </article>

        {/* <1024px: sidebar blocks after the article, before the CTA */}
        <div class="mt-12 grid gap-6 md:grid-cols-2 lg:hidden">
          <div class:list={[cardCls, 'md:col-span-2']}>
            <span class={label}>Insurance we accept</span>
            <InsuranceCarousel class="mt-3" />
          </div>
          <div class={cardCls}><ReviewCard review={review} /></div>
          <div class={cardCls}>
            <span class={label}>Related articles</span>
            <ul class="sv-related mt-3">{related.map((p) => <li><a href={postUrl(p)}>{p.title}</a></li>)}</ul>
          </div>
        </div>
      </div>

      {/* ≥1024px: sticky sidebar */}
      <aside class="sv-sidebar hidden lg:sticky lg:top-[100px] lg:block" aria-label="Article tools">
        <div class="space-y-5">
          {hasToc && (
            <nav class={cardCls} aria-labelledby="toc-title">
              <span id="toc-title" class={label}>In this article</span>
              <TocList items={toc} class="mt-3" />
            </nav>
          )}
          <div class="rounded-[var(--radius-card)] bg-teal p-6 text-white">
            <p class="font-display text-xl font-bold leading-snug text-white">Questions about treatment? Talk with our admissions team.</p>
            <a href={SITE.phoneHref} class="btn-sun mt-4 w-full"><Icon name="phone" class="h-4 w-4" />Call {SITE.phone}</a>
          </div>
          <div class={cardCls}>
            <span class={label}>Insurance we accept</span>
            <InsuranceCarousel class="mt-2" />
          </div>
          <div class={cardCls}><ReviewCard review={review} /></div>
          <div class={cardCls}>
            <span class={label}>Related articles</span>
            <ul class="sv-related mt-3">{related.map((p) => <li><a href={postUrl(p)}>{p.title}</a></li>)}</ul>
          </div>
        </div>
      </aside>
    </div>
  </div>

  {/* Latest articles: full width below the article + sidebar block (QA batch 11 item 8) */}
  <section class="bg-mist pb-14 sm:pb-16" aria-labelledby="latest-title">
    <div class="container-x pt-4 lg:pt-6">
      <h2 id="latest-title" class="text-2xl sm:text-3xl">Latest Articles</h2>
      <ul class="mt-6 grid gap-6 md:grid-cols-2 lg:grid-cols-3" data-latest>
        {latest.map((p) => <li><PostCard post={p} as="h3" size="sm" /></li>)}
      </ul>
    </div>
  </section>

  <CtaBand headingLevel="h2" />

</Base>

<style>
  .sv-article > :global(:first-child) { margin-top: 0; }
  .sv-article { max-width: 72ch; }
  /* H1 = article column width at ≥1024px (container − 340px sidebar − 30px gap) */
  @media (min-width: 1024px) {
    .sv-post-hero :global(.sv-hero .max-w-3xl) { max-width: calc(100% - 370px); }
  }
  /* Labels inside the body: "Summary by the Sunview Wellness team" · "From the episode description…" */
  .sv-article :global(.sv-src-label) {
    margin-top: 0.5rem; font-size: 13px; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-muted);
  }
  /* Verbatim episode notes: set apart from our copy */
  .sv-article :global(.sv-notes) { border-left: 3px solid var(--color-gold); padding-left: 1.25rem; }
  .sv-article :global(.sv-notes > * + *) { margin-top: 1em; }
  .sv-article :global(.sv-chapters li + li) { margin-top: 0.35rem; }
  .sv-article :global(.sv-chapters) { list-style: none; padding-left: 0; font-size: 15px; }
  /* Related articles: plain list of titles (QA batch 11 item 9) */
  .sv-related { list-style: disc; padding-left: 1.1rem; }
  .sv-related li { padding: 0.35rem 0; }
  .sv-related li::marker { color: var(--color-gold); }
  .sv-related a { font-weight: 700; line-height: 1.35; color: var(--color-charcoal); }
  .sv-related a:hover { color: var(--color-teal); text-decoration: underline; }
  /* Sticky sidebar: stays 100px from the top (84px header + 16px); scrolls inside itself when taller than the viewport */
  @media (min-width: 1024px) {
    .sv-sidebar { max-height: calc(100vh - 116px); overflow-y: auto; overscroll-behavior: contain; scrollbar-width: thin; border-radius: 12px; }
  }
</style>

<script>
  // Load the YouTube iframe only when asked (keeps pages fast and avoids third-party cookies until play).
  document.querySelectorAll<HTMLElement>('.yt-facade').forEach((el) => {
    el.querySelector('button')?.addEventListener('click', () => {
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${el.dataset.yt}?autoplay=1&rel=0`;
      iframe.title = el.dataset.title || 'Video';
      iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
      iframe.allowFullscreen = true;
      iframe.className = 'absolute inset-0 h-full w-full';
      el.replaceChildren(iframe);
    });
  });
  // Table of contents behavior lives in components/toc (TocList + TocDrawer).
</script>
