---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import TelemedCard from '../components/TelemedCard.astro';
import Accreditations from '../components/Accreditations.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import { TEAM, initials } from '../data/site.js';

const people = TEAM.flatMap((g) => g.people);
---
<Base
  title="About Sunview Wellness | Our Addiction Treatment Team in West Palm Beach"
  description="Meet Sunview Wellness: a Joint Commission accredited, PhD-led addiction treatment team with 50+ years of combined experience in drug rehab and dual diagnosis care in West Palm Beach, FL."
  breadcrumbs={[{ name: 'About Us', href: '/about-us/' }]}
  schema={[{
    '@context': 'https://schema.org',
    '@type': 'AboutPage',
    name: 'About Sunview Wellness',
    mainEntity: people.map((p) => ({ '@type': 'Person', name: p.name, jobTitle: p.role, worksFor: { '@id': 'https://sunviewwellness.com/#organization' } })),
  }]}
>
  <PageHero
    eyebrow="About Sunview Wellness"
    title="Clinical excellence."
    accent="Personalized care."
    lead="Our multidisciplinary team brings over 50 years of combined clinical experience, and a shared belief that treatment should be clinically serious without losing its humanity."
    compact
  />

  <section class="section">
    <div class="container-x grid items-center gap-12 lg:grid-cols-2">
      <div>
        <span class="eyebrow">Who we are</span>
        <h2 class="mt-3 text-3xl sm:text-4xl">A community-based program that refuses to be “good enough”</h2>
        <div class="mt-6 space-y-4 text-lg text-charcoal">
          <p>Sunview Wellness is an outpatient behavioral health program in West Palm Beach. We work only at the PHP, IOP and OP levels of care, and our clients live at home, with their families, in their communities.</p>
          <p>That’s intentional. We believe sobriety isn’t proven in treatment. It’s proven in life. So we built a program where real life is part of the clinical work, guided by our CEO’s Clinical Architecture™ framework: clinical excellence and a recovery culture where people feel known.</p>
        </div>
      </div>
      <ul class="grid gap-4 sm:grid-cols-2">
        {[
          { icon: 'award', t: 'Joint Commission accredited' },
          { icon: 'users', t: 'PhD-led clinical team' },
          { icon: 'heart', t: 'Trauma-informed, every clinician' },
          { icon: 'message', t: 'Bilingual English/Spanish therapist' },
        ].map((x) => (
          <li class="card flex items-center gap-4">
            <span class="inline-flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-mist text-teal"><Icon name={x.icon} class="h-6 w-6" /></span>
            <p class="font-extrabold text-charcoal">{x.t}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {TEAM.map((group, gi) => (
    <section class:list={['section', gi % 2 === 0 ? 'bg-mist' : 'bg-white']}>
      <div class="container-x">
        <span class="eyebrow">{group.group}</span>
        <h2 class="mt-3 text-3xl sm:text-4xl">
          {group.group === 'Leadership' ? 'Executive & clinical leadership' : group.group === 'Clinical Team' ? 'Therapists & group facilitators' : 'Direct care & support staff'}
        </h2>
        <ul class:list={['mt-10 grid gap-6', group.people.length === 2 ? 'md:grid-cols-2' : 'md:grid-cols-2 lg:grid-cols-3']}>
          {group.people.map((p) => (
            <li class="card flex flex-col">
              <div class="flex items-center gap-4">
                <span class="inline-flex h-16 w-16 shrink-0 items-center justify-center rounded-full bg-teal font-display text-xl font-bold text-white" aria-hidden="true">{initials(p.name)}</span>
                <div>
                  <h3 class="text-xl">{p.name}</h3>
                  <p class="font-bold text-teal">{p.role}</p>
                </div>
              </div>
              <p class="mt-4 text-xs font-extrabold uppercase tracking-[0.1em] text-teal">{p.creds}</p>
              <p class="mt-3 text-charcoal">{p.bio}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>
  ))}

  <section class="section bg-white">
    <div class="container-x grid items-center gap-10 lg:grid-cols-2">
      <div>
        <span class="eyebrow">Medical & psychiatric partnership</span>
        <h2 class="mt-3 text-3xl sm:text-4xl">Specialized psychiatric care, built into treatment</h2>
        <p class="mt-5 text-lg text-charcoal">Through our referral relationship with Telemed Clinix, clients get psychiatric medication management from providers who understand the complexities of dual diagnosis and addiction.</p>
      </div>
      <TelemedCard />
    </div>
  </section>

  <Accreditations />
  <CtaBand title="Talk to our team" lead="Have a question for a clinician before you decide? Call us. We’re happy to help you figure out whether Sunview is the right fit." />
</Base>
