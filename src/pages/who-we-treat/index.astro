---
// /who-we-treat/: hub for the Who We Treat section (2026-10-15). Keyword targets: outpatient rehab for adults,
// outpatient rehab West Palm Beach (140), IOP West Palm Beach (320), plus the audience terms of each child page.
// Rule for the section (data/whoWeTreat.js): people Sunview welcomes into its regular groups, never a dedicated track.
// Facts: docs/content/programs-sources.md (schedules, pre-screening, transportation, scope).
import ServicePage from '../../layouts/ServicePage.astro';
import Icon from '../../components/Icon.astro';
import ScopeNote from '../../components/ScopeNote.astro';
import { WHO, AUDIENCE_PAGES, ALSO_WELCOME } from '../../data/whoWeTreat.js';

const hours = [
  { code: 'PHP', name: 'Partial Hospitalization', when: 'Monday to Friday, 9 AM to 1 PM', h: 20, href: '/programs/php/' },
  { code: 'Day IOP', name: 'Intensive Outpatient, day', when: 'Three mornings a week, 9 AM to 1 PM', h: 12, href: '/programs/iop/' },
  { code: 'Evening IOP', name: 'Intensive Outpatient, evening', when: 'Monday, Wednesday and Thursday, 6 to 9 PM', h: 9, href: '/programs/evening-iop/' },
  { code: 'OP', name: 'Outpatient Program', when: 'One morning a week, 9 AM to 1 PM', h: 4, href: '/programs/outpatient/' },
];

const common = [
  { icon: 'home', title: 'You live at home', text: 'Sunview is outpatient care. You sleep in your own bed, and free door-to-door transportation is available if you can’t drive.' },
  { icon: 'calendar', title: 'You have somewhere to be', text: 'A job, a class schedule, kids, a family business. Treatment is scheduled around the life you’re trying to keep.' },
  { icon: 'check-circle', title: 'You’re medically stable', text: 'You’re not in active withdrawal. If detox needs to come first, we help you get there and plan Sunview as your next step.' },
  { icon: 'users', title: 'You want more than a weekly appointment', text: 'Group therapy several days a week, your own therapist and psychiatric care, in one plan.' },
];

const faqs = [
  { q: 'Who does Sunview Wellness treat?', a: 'Adults 18 and over with substance use disorders, often alongside anxiety, depression, trauma or another co-occurring mental health condition. Most people we treat live at home in Palm Beach County and are working, studying or caring for family while they get help.' },
  { q: 'Do you have separate programs for professionals, students or young adults?', a: 'Everyone joins the same clinical groups in PHP, IOP or OP, and your treatment plan, therapist and schedule are built around your life. What changes for each person is the plan, not the program. <a href="/programs/">Compare levels of care</a>.' },
  { q: 'Can I keep working or going to school during treatment?', a: 'That’s what outpatient care is for. Evening IOP meets Monday, Wednesday and Thursday from 6 to 9 PM, and day IOP meets three mornings a week. <a href="/programs/evening-iop/">See evening IOP</a>.' },
  { q: 'Does Sunview provide housing?', a: 'Sunview is outpatient care, so you live at home during treatment. If you need housing or sober living first, call us and we’ll help you find residential care and plan Sunview as your next step.' },
  { q: 'Is there an age limit?', a: 'Our programs are for adults 18 and over. If you’re looking for help for someone younger, call and we’ll point you to an adolescent provider.' },
  { q: 'How do I know which level of care I need?', a: 'You don’t have to know before you call. After a short pre-screening, our Clinical Director recommends PHP, IOP or OP using ASAM criteria and clinical judgment. <a href="/admissions/">Start with admissions</a>.' },
];

const max = Math.max(...hours.map((h) => h.h));
---
<ServicePage
  path="/who-we-treat/"
  pageType="CollectionPage"
  metaTitle="Who We Treat: Outpatient Rehab for Adults | Sunview Wellness"
  description="Outpatient addiction treatment in West Palm Beach for working professionals, young adults, college students, first responders and families. Adults 18+."
  crumbs={[WHO]}
  h1="Who We Treat at Sunview Wellness"
  subheading="Outpatient care for adults who live at home and have a life to keep."
  lead="Sunview treats adults 18 and over with substance use and co-occurring mental health conditions in PHP, IOP and OP. Most people we see are working, studying or raising a family, and they need treatment that fits around that life instead of replacing it."
  faqTitle="Frequently Asked Questions About Who We Treat"
  faqs={faqs}
  reviews
>
  {/* 1. Audience cards */}
  <section class="section">
    <div class="container-x">
      <span class="eyebrow">Find yourself here</span>
      <h2 class="mt-3 max-w-3xl text-3xl sm:text-[2.1875rem]">Outpatient Addiction Treatment for the Life You Already Have</h2>
      <p class="subheading mt-3">The people who walk through our door most often</p>
      <p class="mt-5 max-w-3xl text-lg">Everyone at Sunview joins the same clinical groups, led by the same licensed team. There are no separate tracks. What we build around you is the plan: which program, which hours, which therapist and what your week looks like. These pages explain how that works for people in your situation.</p>
      <ul class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {AUDIENCE_PAGES.map((p) => (
          <>{/* Explicit whitespace keeps text extractors from running labels together */}<li>
            <a href={p.href} class="card group flex h-full flex-col transition hover:border-teal">
              <span class="inline-flex h-12 w-12 items-center justify-center rounded-full bg-mist"><Icon name={p.icon} class="h-6 w-6 text-teal" /></span>
              <h3 class="mt-5 text-xl text-charcoal group-hover:text-teal">{p.label}</h3>
              <p class="mt-2 flex-1">{p.short}</p>
              <span class="mt-5 inline-flex items-center gap-2 font-bold text-teal">How treatment works for you <Icon name="arrow" class="h-4 w-4" /></span>
            </a>
          </li>{' '}</>
        ))}
      </ul>
    </div>
  </section>

  {/* 2. What they share */}
  <section class="section bg-mist">
    <div class="container-x">
      <span class="eyebrow">What they have in common</span>
      <h2 class="mt-3 max-w-3xl text-3xl sm:text-[2.1875rem]">Who Outpatient Rehab in West Palm Beach Is Right For</h2>
      <p class="subheading mt-3">Four things most of the people we treat share</p>
      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {common.map((c) => (
          <div class="card">
            <Icon name={c.icon} class="h-7 w-7 text-teal" />
            <h3 class="mt-4 text-xl">{c.title}</h3>
            <p class="mt-2">{c.text}</p>
          </div>
        ))}
      </div>
      <div class="prose-sv mt-12 max-w-3xl">
        <p>Sunview was built on a simple idea our CEO calls <a href="/about/our-approach/">In Vivo Treatment™</a>: recovery is practiced where you actually live. You go to work or class, you come to group, and you bring the real moments of your week into the room. A hard meeting, a craving on the drive home, a fight with a parent. That is the material the work is done on.</p>
        <p>It also means we look at more than the substance. Many of the people we treat are struggling with anxiety, depression or trauma at the same time, and we treat both together as <a href="/what-we-treat/dual-diagnosis/">dual diagnosis</a>, with one team and one plan.</p>
      </div>
    </div>
  </section>

  {/* 3. Hours chart */}
  <section class="section">
    <div class="container-x grid gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:items-center">
      <div>
        <span class="eyebrow">Levels of care</span>
        <h2 class="mt-3 text-3xl sm:text-[2.1875rem]">How Many Hours a Week Is Outpatient Treatment?</h2>
        <p class="subheading mt-3">From 20 hours a week down to one morning</p>
        <p class="mt-5 text-lg">Most people start where their pre-screening points and step down as they get stronger, with the same team the whole way. Our Clinical Director recommends your starting level using ASAM criteria and clinical judgment.</p>
        <a href="/programs/" class="btn-ghost mt-8">Compare levels of care</a>
      </div>
      <figure class="card !p-7">
        <figcaption class="font-bold text-charcoal">Hours of group therapy per week, by program</figcaption>
        <ul class="mt-6 space-y-5">
          {hours.map((h) => (
            <li>
              <div class="flex items-baseline justify-between gap-4">
                <a href={h.href} class="font-bold text-teal hover:text-teal-light">{h.code}</a>
                <span class="text-sm font-bold text-charcoal">about {h.h} hours</span>
              </div>
              <div class="mt-2 h-3 rounded-full bg-mist" aria-hidden="true"><div class="h-3 rounded-full bg-teal" style={`width:${Math.round((h.h / max) * 100)}%`}></div></div>
              <p class="mt-1.5 text-sm text-muted">{h.when}</p>
            </li>
          ))}
        </ul>
      </figure>
    </div>
  </section>

  {/* 4. Also welcome */}
  <section class="section bg-mist">
    <div class="container-x">
      <span class="eyebrow">Also in our groups</span>
      <h2 class="mt-3 max-w-3xl text-3xl sm:text-[2.1875rem]">More Adults We Treat in Our PHP, IOP and OP Programs</h2>
      <p class="subheading mt-3">Same groups, same team, a plan built for you</p>
      <ul class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {ALSO_WELCOME.map((a) => (
          <>{' '}<li class="card flex flex-col">
            <Icon name={a.icon} class="h-7 w-7 text-teal" />
            <h3 class="mt-4 text-xl">{a.title}</h3>
            <p class="mt-2 flex-1">{a.text}</p>
            <a href={a.href} class="mt-5 inline-flex items-center gap-2 font-bold text-teal hover:text-teal-light">{a.link} <Icon name="arrow" class="h-4 w-4" /></a>
          </li>{' '}</>
        ))}
      </ul>
    </div>
  </section>

  {/* 5. Start */}
  <section class="section">
    <div class="container-x grid gap-10 lg:grid-cols-2">
      <div>
        <span class="eyebrow">Getting started</span>
        <h2 class="mt-3 text-3xl sm:text-[2.1875rem]">Call Sunview and Tell Us About Your Week</h2>
        <p class="subheading mt-3">You don’t need a referral or a diagnosis to call</p>
        <p class="mt-5 text-lg">The first call is a conversation about what has been happening and what your days look like. We check your insurance for free, run a short pre-screening, and our Clinical Director recommends the level of care that fits. If something else needs to come first, we tell you and help you get there.</p>
        <a href="/admissions/" class="btn-teal mt-8">Talk to admissions <Icon name="arrow" /></a>
      </div>
      <div class="self-center"><ScopeNote /></div>
    </div>
  </section>
</ServicePage>
